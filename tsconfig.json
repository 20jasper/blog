{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"strictNullChecks": true,
		"exactOptionalPropertyTypes": false,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@images/*": ["./src/images/*"],
			"@content/*": ["./src/content/*"],
			"@services/*": ["./src/services/*"],
			"@src/*": ["./src/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}
