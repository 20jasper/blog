---
import BaseHead from '@components/base-head.astro';
import Header from '@components/nav/nav.astro';
import { NAME } from '@src/consts';
import '@src/styles/global.css';

type Props = {
	title: string;
	description?: string;
	math?: boolean;
};

const { math, title, description } = Astro.props;

// overflow-x-hidden on both <html> and <body> below: a deep descendant with
// its own overflow-x-auto region (e.g. a wide DataTable, which is
// legitimately exempt from WCAG 1.4.10 reflow) can still make the page
// itself horizontally scrollable at narrow viewports, even though that
// region correctly contains its own content. Confirmed empirically that
// this needs setting on *both* elements -- body alone left the page
// scrollable in this flex-column layout. Doesn't affect the DataTable's own
// internal scrolling, which is a separate overflow context.
---

<!doctype html>
<html
	lang="en"
	class="overflow-x-hidden"
>
	<BaseHead
		title={title}
		description={description ?? ''}
		math={math}
	/>

	<body
		class="bg-background text-foreground flex min-h-screen flex-col overflow-x-hidden px-4 font-sans text-xl"
	>
		<Header border="bottom" />
		<slot />
		<div class="mt-auto">
			<Header border="top" />
			<footer class="p-4">
				<nav
					aria-label="webring"
					class="gap-2 pb-4 text-center"
				>
					<a href="https://webring.jacobasper.com/prev/20jasper"
						><span aria-hidden="true">←</span>Previous</a
					>
					<a
						class="px-2"
						href="https://webring.jacobasper.com/"
						>Really Cool Blogger Web Ring</a
					>
					<a href="https://webring.jacobasper.com/next/20jasper"
						>Next<span aria-hidden="true">→</span></a
					>
				</nav>
				<p class="text-foreground-secondary text-center text-sm">
					&copy; {new Date().getFullYear()}
					{NAME}. &copy; 2020 VSCode Orange Theme <a
						href="https://marketplace.visualstudio.com/items?itemName=Rax.vscode-orange-theme"
						>Rax Team</a
					>. All rights reserved.
				</p>
			</footer>
		</div>
	</body>
</html>
