---
import FormattedDate from '@components/date/formatted-date.astro';
import Prose from '@components/prose.astro';
import { titleToHtml } from '@src/utils/render-title';

type Props = {
	title: string;
	date: Date;
	updatedDate?: Date | undefined;
	emDashCount: number;
	children: any;
};

const { title, date, updatedDate, emDashCount } = Astro.props;
---

<Prose>
	<div class="mb-2 py-2 text-center">
		<h1 set:html={titleToHtml(title)} />
		<div class="not-prose text-foreground-secondary">
			<p class="m-0 text-lg font-semibold">
				Em dashes: {emDashCount}
			</p>
			<p class="mb-1">
				<FormattedDate date={date} />
				{
					updatedDate && (
						<div class="italic">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)
				}
			</p>
		</div>
	</div>
	<slot />
</Prose>
