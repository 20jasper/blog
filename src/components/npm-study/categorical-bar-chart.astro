---
// Generic bar-chart shape, shared by Categories/Maintainers/RangeOnly.
import ChartCard from './chart-card.astro';
import DataTable from './data-table.astro';

type Column = { label: string };

type CategoricalChart = {
	id: string;
	title: string;
	alt: string;
	height?: number;
	inverted: boolean;
	categories: string[];
	values: number[];
	tooltips: string[];
	valueAxisType?: 'logarithmic' | 'linear';
	valueAxisMin: number;
	valueAxisMax: number;
	valueFormat?: string;
	categoryAxisTitle?: string;
	valueAxisTitle?: string;
	// Semantic roles, resolved to real colors at runtime via colors().
	colorRoles: readonly ('primary' | 'secondary')[];
	tableColumns: Column[];
	tableRows: (string | number)[][];
};
type Props = { chart: CategoricalChart };
const {
	id,
	title,
	alt,
	height = 340,
	inverted,
	categories,
	values,
	tooltips,
	valueAxisType = 'linear',
	valueAxisMin,
	valueAxisMax,
	valueFormat = '{value}',
	categoryAxisTitle,
	valueAxisTitle,
	colorRoles,
	tableColumns,
	tableRows,
} = Astro.props.chart;

const config = {
	title,
	inverted,
	categories,
	values,
	tooltips,
	valueAxisType,
	valueAxisMin,
	valueAxisMax,
	valueFormat,
	categoryAxisTitle,
	valueAxisTitle,
	colorRoles,
};
---

<ChartCard
	id={id}
	title={title}
	alt={alt}
	height={height}
	kind="categorical-bar"
	config={config}
>
	<Fragment slot="table">
		<DataTable
			columns={tableColumns}
			rows={tableRows}
		/>
	</Fragment>
</ChartCard>

<script>
	import Highcharts from './highcharts';
	import { colors } from './theme';
	import {
		baseOptions,
		axisLabelStyle,
		axisLineStyle,
		axisTitleStyle,
	} from './highcharts-theme';

	type Config = {
		title: string;
		inverted: boolean;
		categories: string[];
		values: number[];
		tooltips: string[];
		valueAxisType: 'logarithmic' | 'linear';
		valueAxisMin: number;
		valueAxisMax: number;
		valueFormat: string;
		categoryAxisTitle?: string;
		valueAxisTitle?: string;
		colorRoles: ('primary' | 'secondary')[];
	};

	function buildXAxis(config: Config) {
		return {
			type: 'category' as const,
			categories: config.categories,
			title: config.categoryAxisTitle
				? axisTitleStyle(config.categoryAxisTitle)
				: { text: undefined },
			...axisLineStyle(),
			labels: { ...axisLabelStyle() },
		};
	}

	function buildYAxis(config: Config) {
		return {
			type: config.valueAxisType,
			min: config.valueAxisMin,
			max: config.valueAxisMax,
			title: config.valueAxisTitle
				? axisTitleStyle(config.valueAxisTitle)
				: { text: undefined },
			gridLineColor: axisLineStyle().gridLineColor,
			labels: { ...axisLabelStyle(), format: config.valueFormat },
		};
	}

	function buildChart(container: HTMLElement, config: Config) {
		const c = colors();
		const palette = config.colorRoles.map((role) => c[role]);
		const chartType = config.inverted ? 'bar' : 'column';
		Highcharts.chart(container, {
			...baseOptions(),
			chart: { ...baseOptions().chart, type: chartType },
			accessibility: {
				point: {
					valueDescriptionFormat: '{point.category}: {point.custom.tooltip}.',
				},
			},
			xAxis: buildXAxis(config),
			yAxis: buildYAxis(config),
			legend: { enabled: false },
			tooltip: {
				...baseOptions().tooltip,
				formatter() {
					const p = this as unknown as { custom: { tooltip: string } };
					return p.custom.tooltip;
				},
			},
			series: [
				{
					type: chartType,
					name: config.title,
					data: config.values.map((v, i) => ({
						y: v,
						custom: { tooltip: config.tooltips[i] },
					})),
					colorByPoint: palette.length > 1,
					colors: palette.length > 1 ? palette : undefined,
					color: palette.length === 1 ? palette[0] : undefined,
				},
			],
		});
	}

	// Astro dedupes identical scripts, so find every container, not just one.
	document
		.querySelectorAll<HTMLElement>('[data-chart-kind="categorical-bar"]')
		.forEach((container) => {
			const config: Config = JSON.parse(container.dataset.chartConfig ?? '{}');
			buildChart(container, config);
		});
</script>
