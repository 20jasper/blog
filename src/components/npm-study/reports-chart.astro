---
import ChartCard from './chart-card.astro';
import DataTable from './data-table.astro';
import { REPORTS_OVER_TIME } from './data';
---

<ChartCard
	id="chart-reports"
	title="reports over time: when detections actually landed"
	alt="Combo chart of monthly detection-report counts as bars with a 3-month rolling average as a line, from June 2022 through August 2026, where volume grows from a handful a month in 2022 to thousands a month by 2026, with tall single-month spikes in June 2024, December 2025, and August 2026 driven by single-vendor batch scans rather than organic growth."
>
	<Fragment slot="table">
		<DataTable
			columns={[{ label: 'month' }, { label: 'reports' }]}
			rows={REPORTS_OVER_TIME.map((d) => [d.m, d.n.toLocaleString()])}
		/>
	</Fragment>
</ChartCard>

<script>
	import Highcharts from './highcharts';
	import { REPORTS_OVER_TIME } from './data';
	import { colors, ink } from './theme';
	import {
		baseOptions,
		axisLabelStyle,
		axisLineStyle,
		DASH_LINE_WIDTH,
	} from './highcharts-theme';

	const container = document.querySelector<HTMLElement>('#chart-reports');
	if (container) {
		const c = colors();
		const rolling = REPORTS_OVER_TIME.map((_, i) => {
			const slice = REPORTS_OVER_TIME.slice(Math.max(0, i - 2), i + 1);
			return Math.round(slice.reduce((s, d) => s + d.n, 0) / slice.length);
		});
		Highcharts.chart(container, {
			...baseOptions(),
			accessibility: {
				description:
					'Combo chart of monthly detection-report counts as bars with a 3-month rolling average as a line, from June 2022 through August 2026, growing from a handful a month to thousands a month, with tall single-month spikes from single-vendor batch scans.',
			},
			xAxis: {
				categories: REPORTS_OVER_TIME.map((d) => d.m),
				...axisLineStyle(),
				labels: { ...axisLabelStyle() },
				tickInterval: 4,
			},
			yAxis: {
				title: { text: undefined },
				gridLineColor: axisLineStyle().gridLineColor,
				labels: {
					...axisLabelStyle(),
					formatter() {
						return Number(this.value).toLocaleString();
					},
				},
			},
			legend: { enabled: true, itemStyle: { color: ink() } },
			series: [
				{
					type: 'column',
					name: 'reports',
					data: REPORTS_OVER_TIME.map((d) => d.n),
					color: c.primary,
				},
				{
					type: 'line',
					name: '3-month rolling average',
					data: rolling,
					color: c.secondary,
					lineWidth: DASH_LINE_WIDTH,
				},
			],
		});
	}
</script>
