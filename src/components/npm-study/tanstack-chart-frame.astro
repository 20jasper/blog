---
// Owns the <figure> every @tanstack/charts component wraps itself in --
// pulled out once real components existed side by side and the container
// div + CSS turned out to be the exact same ~15 lines in each of them, only
// `height` and an extra class (for the threshold chart's own
// document-scoped mount query) varying. `caption` is a prop, not something
// each chart re-hardcodes its own <figcaption> markup for -- a plain string
// is enough since every caption so far has been one sentence of caveat text.
type Props = {
	id: string;
	config: unknown;
	height?: number;
	class?: string;
	caption?: string;
};
const { id, config, height = 300, class: extraClass, caption } = Astro.props;
---

<figure class="not-prose my-8">
	<slot name="header" />
	<div
		id={id}
		class:list={['ts-chart', extraClass]}
		style={`height:${height}px`}
		data-chart-config={JSON.stringify(config)}
	>
	</div>
	<slot />
	{
		caption && (
			<figcaption class="text-foreground-secondary mt-2 font-mono text-sm">
				{caption}
			</figcaption>
		)
	}
</figure>

<style>
	.ts-chart {
		/* Reuse the exact same design tokens theme.ts reads via getComputedStyle --
		   here they're just plain CSS custom properties, no JS bridge needed. */
		color: var(--color-foreground);
		background: transparent;
		--ts-chart-1: var(--color-chart-primary);
		/* Undocumented defaults read from `Canvas`/`CanvasText` system colors --
		   renders near-white on most setups. Point it at our own tokens instead
		   so a ref-line-merged tooltip matches the rest of the chart instead of
		   looking like a stray browser default. */
		--ts-chart-tooltip-background: var(--color-background-secondary);
		--ts-chart-tooltip-color: var(--color-foreground);
		--ts-chart-tooltip-border: 1px solid var(--color-foreground-secondary);
	}
	/* Chart text renders as an SVG `font-size` attribute, which is the lowest-
	   priority CSS origin -- this class selector overrides it outright. Only
	   size changes; font-family is left alone (already "inherit"). */
	.ts-chart :global(text) {
		font-size: var(--text-base);
	}
	/* ruleX has no `states` field, so it can never paint itself differently on
	   hover/focus the way area/line/dot marks can -- its render() doesn't
	   branch on that at all. `:hover` alone would only ever cover the mouse;
	   `.is-focused` is toggled from the real `onFocusChange` host callback,
	   which fires for hover *and* keyboard nav alike since it's the same
	   underlying focus concept the tooltip itself uses. Harmless no-op on a
	   chart with no ruleX marks -- the selector just never matches anything. */
	.ts-chart :global(.ts-chart__rule-x line:hover),
	.ts-chart :global(.ts-chart__rule-x.is-focused line) {
		stroke-opacity: 1;
		stroke-width: 6;
	}
</style>
