---
// Owns the table markup and its collapsed-by-default disclosure.
type Column = { label: string };
type Props = {
	columns: Column[];
	rows: (string | number)[][];
};
const { columns, rows } = Astro.props;
---

<details class="mt-3 text-base">
	<summary
		class="text-foreground-secondary hover:text-foreground cursor-pointer"
		>Show data table</summary
	>
	<div class="mt-2 overflow-x-auto">
		<table class="w-full border-collapse font-mono text-base">
			<thead>
				<tr class="border-foreground-secondary/30 border-b">
					{columns.map((c) => <th class="p-3 text-left">{c.label}</th>)}
				</tr>
			</thead>
			<tbody class="text-foreground-secondary">
				{
					rows.map((row) => (
						<tr class="border-foreground-secondary/10 border-b">
							{row.map((cell) => (
								<td class="p-3 text-left">{cell}</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</details>
