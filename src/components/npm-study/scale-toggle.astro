---
type Props = { chartId: string };
const { chartId } = Astro.props;
---

<fieldset
	class="border-foreground-secondary/40 bg-background-secondary/40 flex gap-0.5 rounded-full border text-xs"
>
	<legend class="text-foreground-secondary px-1.5">Chart scale</legend>
	<button
		type="button"
		data-scale-btn="logarithmic"
		data-chart={chartId}
		class="scale-btn rounded-full px-2.5 py-1 font-medium"
		aria-pressed="true"
		>Log</button
	>
	<button
		type="button"
		data-scale-btn="linear"
		data-chart={chartId}
		class="scale-btn rounded-full px-2.5 py-1 font-medium"
		aria-pressed="false"
		>Linear</button
	>
</fieldset>

<style>
	/* Native <fieldset>/<legend> replace the old div[role=group]/aria-label --
	   same grouping semantics, no hand-authored ARIA, and the legend is a
	   real visible label instead of an aria-label. Reset fieldset's default
	   border/margin so it lays out identically to the div it replaced;
	   padding is set here (not as a p-0.5 utility) because Astro's
	   scoped-style attribute selector would otherwise outrank that utility
	   class and win the cascade anyway. */
	fieldset {
		border: 0;
		margin: 0;
		padding: 0.125rem;
	}
	/* Styled off aria-pressed, no separate classList.toggle needed. */
	.scale-btn {
		color: var(--color-foreground-secondary);
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.scale-btn:hover {
		color: var(--color-foreground);
	}
	.scale-btn[aria-pressed='true'] {
		/* cream-on-purple clears WCAG AA (~4.6:1); background-on-purple didn't (3.65:1) */
		background: var(--color-chart-primary);
		color: var(--color-foreground);
		font-weight: 700;
		/* Depth cue independent of the color fill -- reads as "pressed in",
		   not just "differently colored", so the active state survives even
		   where the purple-vs-transparent contrast alone reads as subtle. */
		box-shadow: inset 0 1px 2px rgb(0 0 0 / 25%);
	}
	.scale-btn[aria-pressed='false'] {
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 2px;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			text-decoration-color 0.15s ease;
	}
	.scale-btn[aria-pressed='false']:hover {
		text-decoration-color: currentColor;
	}
</style>
