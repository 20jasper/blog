---
import ChartCard from './chart-card.astro';
import DataTable from './data-table.astro';
import { YEAR_MEDIAN } from './data';
---

<ChartCard
	id="chart-yeartrend"
	title="median detection time by year of malicious publish"
	alt="Line chart of median hours from publish to detection, grouped by the year the malicious version was published, log scale, where the median falls from about 48,585 hours (5.5 years) in 2018 to about 28.8 hours in 2026 -- a roughly 1,700-fold drop overall, though the 2018-2019 points are inflated by retroactive scanning and the 2026 point is artificially low from right-censoring, so only the solid 2023-2025 points are directly trustworthy."
>
	<Fragment slot="table">
		<DataTable
			columns={[{ label: 'year' }, { label: 'median' }, { label: 'n' }]}
			rows={YEAR_MEDIAN.map((d) => [
				d.year,
				`${d.median_h.toLocaleString()}h`,
				d.n.toLocaleString(),
			])}
		/>
	</Fragment>
</ChartCard>

<script>
	import Highcharts from './highcharts';
	import { YEAR_MEDIAN } from './data';
	import { colors, surface } from './theme';
	import {
		baseOptions,
		axisLabelStyle,
		axisLineStyle,
	} from './highcharts-theme';

	const container = document.querySelector<HTMLElement>('#chart-yeartrend');
	if (container) {
		const c = colors();
		const solidYears = new Set(['2023', '2024', '2025']);
		Highcharts.chart(container, {
			...baseOptions(),
			accessibility: {
				description:
					'Line chart of median hours from publish to detection by year of malicious publish, log scale, falling from about 48,585 hours in 2018 to about 28.8 hours in 2026 -- though 2018-2019 are inflated by retroactive scanning and 2026 is artificially low from right-censoring, so only 2023-2025 are directly trustworthy.',
			},
			xAxis: {
				categories: YEAR_MEDIAN.map((d) => d.year),
				...axisLineStyle(),
				labels: { ...axisLabelStyle() },
			},
			yAxis: {
				type: 'logarithmic',
				min: 1,
				max: 100000,
				title: { text: undefined },
				gridLineColor: axisLineStyle().gridLineColor,
				labels: { ...axisLabelStyle() },
			},
			legend: { enabled: false },
			tooltip: {
				...baseOptions().tooltip,
				formatter() {
					const p = this as unknown as { y: number; index: number };
					const d = YEAR_MEDIAN[p.index]!;
					return `${d.year}: <b>${p.y.toLocaleString()}h</b> median (n=${d.n.toLocaleString()})`;
				},
			},
			series: [
				{
					type: 'area',
					name: 'median detection time',
					data: YEAR_MEDIAN.map((d) => ({
						y: d.median_h,
						marker: {
							enabled: true,
							radius: solidYears.has(d.year) ? 5 : 4,
							fillColor: solidYears.has(d.year) ? c.primary : surface(),
							lineColor: c.primary,
							lineWidth: 2,
						},
					})),
					color: c.primary,
					fillOpacity: 0.13,
					lineWidth: 2,
				},
			],
		});
	}
</script>
