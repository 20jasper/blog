---
import { REF_LINE_STYLES } from './theme';

type Props = { refLines: { label: string }[] };
const { refLines } = Astro.props;
---

{
	refLines.length > 0 && (
		<ul class="text-foreground-secondary mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm">
			{refLines.map((refLine, i) => {
				const style = REF_LINE_STYLES[i % REF_LINE_STYLES.length]!;
				return (
					<li class="flex items-center gap-1.5">
						<svg
							width="20"
							height="8"
							aria-hidden="true"
						>
							<line
								x1="0"
								y1="4"
								x2="20"
								y2="4"
								stroke={style.color}
								stroke-width="3"
								stroke-dasharray={style.dash}
							/>
						</svg>
						<span>{refLine.label}</span>
					</li>
				);
			})}
		</ul>
	)
}
