---
import DataTable from './data-table.astro';
import ChartFrame from './chart-frame.astro';
import { linearRegressionRowsY } from '@tanstack/charts/regression';
import { MONTHLY_DETECTIONS_CHART } from './data';

const {
	id,
	title,
	caption,
	points,
	months,
	tickMonths,
	niceMax,
	yTicks,
	total,
	tableRows,
} = MONTHLY_DETECTIONS_CHART;

// Computed at build time, not in the client bundle -- linearRegressionRowsY
// is pure math (no DOM), and a straight line only needs its two endpoints,
// so `samples: 2` gets exactly that instead of a 64-point curve to trim
// down. Fit against organic activity alone (not the combined line plotted
// below), so the one-off backfill spike doesn't distort the growth trend.
const trendRows = linearRegressionRowsY(
	points.map((d, i) => ({ i, other: d.other })),
	{ x: 'i', y: 'other', ci: 0, samples: 2 },
);
const trend = trendRows.map((row) => ({
	m: points[Math.round(row.x)]!.m,
	trend: row.y,
}));

const CHART_HEIGHT = 300;

const config = {
	points,
	trend,
	months,
	tickMonths,
	niceMax,
	yTicks,
	title,
	height: CHART_HEIGHT,
};
---

<ChartFrame
	id={id}
	config={config}
	height={CHART_HEIGHT}
	caption={caption}
>
	<Fragment slot="header">
		<p class="text-foreground-secondary font-mono text-base">{title}</p>
		<p class="text-foreground-secondary mt-0.5 font-mono text-sm">
			n = {total.toLocaleString()} detections
		</p>
	</Fragment>
	<ul
		class="text-foreground-secondary mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm"
	>
		<li class="flex items-center gap-1.5">
			<svg
				width="20"
				height="8"
				aria-hidden="true"
			>
				<line
					x1="0"
					y1="4"
					x2="20"
					y2="4"
					stroke="var(--color-chart-primary)"
					stroke-width="3"
				></line>
			</svg>
			<span>detections</span>
		</li>
		<li class="flex items-center gap-1.5">
			<svg
				width="20"
				height="8"
				aria-hidden="true"
			>
				<line
					x1="0"
					y1="4"
					x2="20"
					y2="4"
					stroke="var(--color-chart-tertiary)"
					stroke-width="3"
					stroke-dasharray="2 5"
				></line>
			</svg>
			<span>linear trend</span>
		</li>
	</ul>
</ChartFrame>

<DataTable
	columns={[
		{ label: 'month' },
		{ label: 'other' },
		{ label: 'backfill' },
		{ label: 'tea.xyz' },
	]}
	rows={tableRows}
/>

<script>
	import { defineChart, lineY, mountChart } from '@tanstack/charts';
	import { decorative } from '@tanstack/charts/mark/decorative';
	import { scalePoint } from '@tanstack/charts/scales/point';
	import { tooltip } from '@tanstack/charts/tooltip';
	import { scaleLog } from 'd3-scale';
	import {
		measureText,
		createRuleXFocusHandler,
		formatCount,
	} from './chart-utils';

	type Config = {
		points: { m: string; other: number; backfill: number; combined: number }[];
		trend: { m: string; trend: number }[];
		months: string[];
		tickMonths: string[];
		niceMax: number;
		yTicks: number[];
		title: string;
		height: number;
	};

	document
		.querySelectorAll<HTMLElement>('#chart-monthly-detections')
		.forEach((container) => {
			const config: Config = JSON.parse(container.dataset.chartConfig ?? '{}');
			const xScale = scalePoint<string>().domain(config.months);
			const yScale = scaleLog().domain([1, config.niceMax]);

			mountChart(container, {
				height: config.height,
				initialWidth: 640,
				// Names the whole chart, not just its x-axis. No ariaDescription
				// needed -- the visible <figcaption> above already describes the
				// figure as a whole.
				ariaLabel: config.title,
				measureText,
				// No ref lines on this chart -- the dot alone still needs the
				// handler's focus-dot half, just with nothing to key a glow off.
				onFocusChange: createRuleXFocusHandler(container, new Map()),
				definition: defineChart({
					marks: [
						lineY(config.points, {
							x: 'm',
							y: 'combined',
							stroke: 'var(--ts-chart-1)',
							strokeWidth: 2,
						}),
						// decorative: visual context, not its own focus target -- see
						// the same fix in threshold-curve-chart.astro.
						decorative(
							lineY(config.trend, {
								x: 'm',
								y: 'trend',
								stroke: 'var(--color-chart-tertiary)',
								strokeWidth: 2,
								strokeDasharray: '2 5',
							}),
						),
					],
					x: {
						scale: xScale,
						axis: { label: 'month', ticks: { values: config.tickMonths } },
					},
					y: {
						scale: yScale,
						grid: true,
						axis: {
							label: 'detections',
							ticks: { values: config.yTicks, format: formatCount },
						},
					},
					tooltip: {
						use: tooltip,
						format: (point) => {
							const d = point.datum as {
								m: string;
								other: number;
								backfill: number;
								combined: number;
							};
							const suffix =
								d.backfill > 0
									? ` (${d.other.toLocaleString()} organic + ${d.backfill.toLocaleString()} backfill)`
									: '';
							return `${d.m}: ${d.combined.toLocaleString()}${suffix}`;
						},
					},
				}),
			});
		});
</script>
