---
import DataTable from './data-table.astro';
import ChartFrame from './chart-frame.astro';
import RefLineLegend from './ref-line-legend.astro';
import ChartHeading from './chart-heading.astro';
import { linearRegressionRowsY } from '@tanstack/charts/regression';
import { MONTHLY_DETECTIONS_CHART } from './data';

const legendItems = [
	{ label: 'detections', color: 'var(--color-chart-primary)' },
	{
		label: 'linear trend',
		color: 'var(--color-chart-tertiary)',
		dash: '2 5',
	},
];

const { id, title, caption, rows } = MONTHLY_DETECTIONS_CHART;

// `combined` is this chart's own rendering choice (a summed line), not a
// fact about the data -- rows only carries organic/backfill/tea.xyz apart.
const points = rows.map((d) => ({
	m: d.m,
	other: d.other,
	backfill: d.backfill,
	combined: d.other + d.backfill,
}));
const total = points.reduce((sum, d) => sum + d.combined, 0);

// Computed at build time, not in the client bundle -- linearRegressionRowsY
// is pure math (no DOM), and a straight line only needs its two endpoints,
// so `samples: 2` gets exactly that instead of a 64-point curve to trim
// down. Fit against organic activity alone (not the combined line plotted
// below), so the one-off backfill spike doesn't distort the growth trend.
const trendRows = linearRegressionRowsY(
	points.map((d, i) => ({ i, other: d.other })),
	{ x: 'i', y: 'other', ci: 0, samples: 2 },
);
const trend = trendRows.map((row) => ({
	m: points[Math.round(row.x)]!.m,
	trend: row.y,
}));

const months = points.map((d) => d.m);
// Every 4th month label -- all of them would overlap at this width.
const tickMonths = months.filter((_, i) => i % 4 === 0);
const monthlyMax = Math.max(...points.map((d) => d.combined));
// Rounded up to the next power of 10 -- a log axis reads best with
// power-of-10 gridlines.
const niceMax = 10 ** Math.ceil(Math.log10(monthlyMax));
// [1, 10, ..., niceMax] -- explicit power-of-10 ticks for the log axis.
const yTicks = Array.from(
	{ length: Math.log10(niceMax) + 1 },
	(_, i) => 10 ** i,
);
const tableRows = rows.map((d) => [
	d.m,
	d.other.toLocaleString(),
	d.backfill.toLocaleString(),
	d.tea.toLocaleString(),
]);

const CHART_HEIGHT = 300;

const config = {
	points,
	trend,
	months,
	tickMonths,
	niceMax,
	yTicks,
	title,
	height: CHART_HEIGHT,
};
---

<ChartFrame
	id={id}
	config={config}
	height={CHART_HEIGHT}
	caption={caption}
>
	<Fragment slot="header">
		<ChartHeading
			title={title}
			subtitle={`n = ${total.toLocaleString()} detections`}
		/>
	</Fragment>
	<RefLineLegend items={legendItems} />
</ChartFrame>

<DataTable
	columns={[
		{ label: 'month' },
		{ label: 'other' },
		{ label: 'backfill' },
		{ label: 'tea.xyz' },
	]}
	rows={tableRows}
/>

<script>
	import { defineChart, lineY, mountChart } from '@tanstack/charts';
	import { decorative } from '@tanstack/charts/mark/decorative';
	import { scalePoint } from '@tanstack/charts/scales/point';
	import { tooltip } from '@tanstack/charts/tooltip';
	import { scaleLog } from 'd3-scale';
	import {
		createRuleXFocusHandler,
		formatCount,
		BASE_FONT_PX,
	} from './chart-utils';

	type MonthlyPoint = {
		m: string;
		other: number;
		backfill: number;
		combined: number;
	};

	type Config = {
		points: MonthlyPoint[];
		trend: { m: string; trend: number }[];
		months: string[];
		tickMonths: string[];
		niceMax: number;
		yTicks: number[];
		title: string;
		height: number;
	};

	document
		.querySelectorAll<HTMLElement>('#chart-monthly-detections')
		.forEach((container) => {
			const config: Config = JSON.parse(container.dataset.chartConfig ?? '{}');
			const xScale = scalePoint<string>().domain(config.months);
			const yScale = scaleLog().domain([1, config.niceMax]);

			mountChart(container, {
				height: config.height,
				initialWidth: 640,
				// Names the whole chart, not just its x-axis. No ariaDescription
				// needed -- the visible <figcaption> above already describes the
				// figure as a whole.
				ariaLabel: config.title,
				// No ref lines on this chart -- the dot alone still needs the
				// handler's focus-dot half, just with nothing to key a glow off.
				onFocusChange: createRuleXFocusHandler(container, new Map()),
				definition: defineChart({
					marks: [
						lineY(config.points, {
							x: 'm',
							y: 'combined',
							stroke: 'var(--ts-chart-1)',
							strokeWidth: 2,
						}),
						// decorative: visual context, not its own focus target -- see
						// the same fix in threshold-curve-chart.astro.
						decorative(
							lineY(config.trend, {
								x: 'm',
								y: 'trend',
								stroke: 'var(--color-chart-tertiary)',
								strokeWidth: 2,
								strokeDasharray: '2 5',
							}),
						),
					],
					x: {
						scale: xScale,
						axis: {
							label: { text: 'month', fontSize: BASE_FONT_PX },
							ticks: { values: config.tickMonths },
							tickLabels: { fontSize: BASE_FONT_PX },
						},
					},
					y: {
						scale: yScale,
						grid: true,
						axis: {
							label: { text: 'detections', fontSize: BASE_FONT_PX },
							ticks: { values: config.yTicks, format: formatCount },
							tickLabels: { fontSize: BASE_FONT_PX },
						},
					},
					tooltip: {
						use: tooltip,
						format: (point) => {
							const d = point.datum as MonthlyPoint;
							const suffix =
								d.backfill > 0
									? ` (${d.other.toLocaleString()} organic + ${d.backfill.toLocaleString()} backfill)`
									: '';
							return `${d.m}: ${d.combined.toLocaleString()}${suffix}`;
						},
					},
				}),
			});
		});
</script>
