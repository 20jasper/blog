---
import FormattedDate from './date/formatted-date.astro';
import TagsList from './tags-list.astro';
import type { BlogTag } from '@src/content.config';
import { titleToHtml } from '@src/utils/render-title';

type Props = {
	slug: string;
	title: string;
	date: Date;
	tags: BlogTag[];
};

const { slug, title, date, tags } = Astro.props;
---

<a
	href={`/blog/${slug}`}
	class="block"
>
	<h3
		class="leading-none"
		set:html={titleToHtml(title)}
	/>
</a>
<div class="text-foreground-secondary m-0 pt-2">
	{tags.length > 0 && <TagsList tags={tags} />}
	<FormattedDate date={date} />
</div>
