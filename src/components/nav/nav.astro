---
import NavLink from './nav-link.astro';

export const DEFAULT_NAV_LINKS = [
	{ href: '/blog', text: 'Blog' },
	{ href: '/reading-list', text: 'Reading List' },
	{ href: '/cool-stuff', text: 'Cool Stuff' },
];

type Props = {
	border: 'top' | 'bottom';
	links?: { href: string; text: string }[];
};

const { border, links = DEFAULT_NAV_LINKS } = Astro.props;
const label =
	border === 'bottom' ? 'site navigation' : 'site navigation (footer)';
---

<nav aria-label={label}>
	<ul class="mx-auto flex justify-center">
		{
			links.map((link) => (
				<li class="px-2 py-4">
					<NavLink
						class="px-2 py-4"
						href={link.href}
						border={border}
					>
						{link.text}
					</NavLink>
				</li>
			))
		}
	</ul>
</nav>
