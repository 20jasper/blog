---
import Button from '@components/button.astro';
import { FIELD_CONTROL_CLASS } from '@src/views/citation-builder/components/field-control-class';
---

<p
	id="toa-empty"
	class="text-foreground-secondary"
>
	No saved citations yet.{' '}
	<a
		href="/tools/citations/builder"
		class="text-accent underline"
	>
		Build one
	</a>{' '}
	to get started.
</p>

<p
	id="toa-forms-help"
	class="text-foreground-secondary mb-3 text-sm"
>
	Disabled selections mean some fields are missing for this type.
</p>

<ol
	id="toa-list"
	class="flex flex-col gap-3"
></ol>

<template id="toa-item-template">
	<li class="border-foreground-secondary/30 bg-background-secondary flex flex-wrap items-center justify-between gap-3 rounded-2xl border px-4 py-3">
		<div class="flex flex-col gap-1">
			<span class="toa-item-label"></span>
			<p class="toa-item-notes text-foreground-secondary text-base whitespace-pre-wrap"></p>
		</div>
		<span class="flex items-center gap-2">
			<select
				class={`toa-item-form ${FIELD_CONTROL_CLASS} w-auto`}
				aria-describedby="toa-forms-help"
			></select>
			<a class="toa-item-edit text-accent underline">Edit</a>
			<Button
				type="button"
				variant="flat"
				class="toa-item-copy"
			>
				Copy
			</Button>
			<Button
				type="button"
				variant="flat"
				class="toa-item-delete"
			>
				Delete
			</Button>
		</span>
	</li>
</template>
