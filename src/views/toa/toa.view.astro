---
import PageLayout from '@layouts/page-layout.astro';
import { CITATION_BUILDER_NAV_LINKS } from '@src/views/citation-builder/nav-links';
import SavedCitationsUi from './toa.ui.astro';
---

<PageLayout
	title="Saved Citations"
	navLinks={CITATION_BUILDER_NAV_LINKS}
>
	<h1 class="my-5 text-3xl font-bold">Saved Citations</h1>
	<SavedCitationsUi />
	<script>
		import {
			citationForms,
			currentFormId,
			deleteSavedCitation,
			loadSavedCitations,
			renderCitation,
		} from '@components/citation-builder/state';
		import { writeCitationToClipboard } from '../citation-builder/clipboard';
		import type { SavedCitation } from '@components/citation-builder/state';

		const list = document.querySelector<HTMLOListElement>('#toa-list')!;
		const empty = document.querySelector<HTMLElement>('#toa-empty')!;
		const itemTemplate =
			document.querySelector<HTMLTemplateElement>('#toa-item-template')!;

		const help = document.querySelector<HTMLElement>('#toa-forms-help')!;

		async function copyForm(
			button: HTMLButtonElement,
			citation: SavedCitation,
			formId: string,
		): Promise<void> {
			const form = citationForms(citation.fields, citation.display).find(
				(candidate) => candidate.id === formId,
			);
			if (form === undefined || !form.valid) {
				return;
			}
			await writeCitationToClipboard(
				renderCitation(citation.fields, form.display),
			);
			const original = button.textContent;
			button.textContent = 'Copied!';
			setTimeout(() => {
				button.textContent = original;
			}, 2000);
		}

		function fillFormSelect(
			select: HTMLSelectElement,
			citation: SavedCitation,
		): void {
			select.setAttribute('aria-label', `Form to copy for ${citation.label}`);
			for (const form of citationForms(citation.fields, citation.display)) {
				const option = new Option(form.label, form.id);
				option.disabled = !form.valid;
				select.append(option);
			}
			select.value = currentFormId(citation.display);
		}

		function render(): void {
			const citations = loadSavedCitations();

			empty.hidden = citations.length > 0;
			help.hidden = citations.length === 0;

			const fragment = document.createDocumentFragment();
			for (const citation of citations) {
				const item = itemTemplate.content.cloneNode(true) as DocumentFragment;

				const label = item.querySelector<HTMLElement>('.toa-item-label')!;
				label.textContent = citation.label;

				const notes = item.querySelector<HTMLElement>('.toa-item-notes')!;
				notes.textContent = citation.notes;
				notes.hidden = citation.notes === '';

				const editLink =
					item.querySelector<HTMLAnchorElement>('.toa-item-edit')!;
				editLink.href = `/tools/citations/builder?edit=${citation.id}`;
				editLink.setAttribute('aria-label', `Edit ${citation.label}`);

				const copyButton =
					item.querySelector<HTMLButtonElement>('.toa-item-copy')!;
				copyButton.setAttribute('aria-label', `Copy ${citation.label}`);
				const formSelect =
					item.querySelector<HTMLSelectElement>('.toa-item-form')!;
				fillFormSelect(formSelect, citation);
				copyButton.addEventListener('click', () => {
					void copyForm(copyButton, citation, formSelect.value);
				});

				const deleteButton =
					item.querySelector<HTMLButtonElement>('.toa-item-delete')!;
				deleteButton.setAttribute('aria-label', `Delete ${citation.label}`);
				deleteButton.addEventListener('click', () => {
					if (!confirm(`Delete "${citation.label}"?`)) {
						return;
					}
					deleteSavedCitation(citation.id);
					render();
				});

				fragment.append(item);
			}
			list.replaceChildren(fragment);
		}

		render();
	</script>
</PageLayout>
