---
import BaseLayout from '@layouts/base-layout.astro';
import QuizUi from './quiz.ui.astro';
import {
	questions,
	options,
	TITLE,
	DESCRIPTION,
} from '@content/questions/questions';

const index = 0;
const question = questions[index]!;
---

<BaseLayout
	title={TITLE}
	description={DESCRIPTION}
>
	<QuizUi
		description={DESCRIPTION}
		question={question}
		index={index}
		totalQuestions={questions.length}
		options={options}
	/>
	<script>
		import {
			JSONWTF_BASE_URL,
			questions,
			type Option,
			type Question,
		} from '@content/questions/questions';

		let index = 0;
		let correctAnswers = 0;

		const mount = document.querySelector('#quiz-mount')!;
		const questionTemplate =
			document.querySelector<HTMLTemplateElement>('#question-template')!;
		const finalScoreTemplate = document.querySelector<HTMLTemplateElement>(
			'#final-score-template',
		)!;
		const startScreen = document.querySelector('#starting-explanation')!;
		const startButton = document.querySelector('#start-quiz')!;

		startButton.addEventListener('click', () => {
			index = 0;
			correctAnswers = 0;
			startScreen.classList.add('hidden');
			renderQuestion(index);
		});

		function renderQuestion(questionIndex: number) {
			const question = questions[questionIndex];
			if (!question) {
				renderFinalScore();
				return;
			}

			mount.replaceChildren(questionTemplate.content.cloneNode(true));

			const elements = {
				options: mount.querySelector('#options')!,
				next: mount.querySelector('#next')!,
				question: mount.querySelector('#question')!,
				questionCode: mount.querySelector('#question-code')!,
				explanation: mount.querySelector('#explanation')!,
				citationLink: mount.querySelector(
					'#citation-link',
				) as HTMLAnchorElement,
				explanationContainer: mount.querySelector('#explanation-container')!,
				validOrNot: mount.querySelector('#valid-or-not')!,
			};

			elements.question.textContent = `question ${questionIndex + 1} of ${questions.length}`;
			elements.questionCode.textContent = question.json;
			elements.explanation.replaceChildren(
				createExplanationFragment(question.explanation),
			);
			elements.citationLink.href = question.citation;
			elements.citationLink.textContent = question.citationLabel;

			elements.options.addEventListener('click', (event) =>
				onOptionSelected(event, question, elements),
			);
			elements.next.addEventListener('click', () => {
				index += 1;
				renderQuestion(index);
			});
		}

		function onOptionSelected(
			event: Event,
			question: Question,
			elements: {
				validOrNot: Element;
				explanationContainer: Element;
				options: Element;
				next: Element;
			},
		) {
			const target = event.target as Element | null;
			const selected = target?.id;
			if (selected === question.answer) {
				correctAnswers += 1;
			}

			const validOrNotText = `${
				selected === question.answer ? 'Correct ✅' : 'Wrong ❌'
			}: ${getValidOrNotText(question.answer)}`;
			elements.validOrNot.textContent = validOrNotText;
			elements.explanationContainer.classList.remove('invisible');
			elements.options.classList.add('hidden');
			elements.next.classList.remove('hidden');
		}

		function renderFinalScore() {
			mount.replaceChildren(finalScoreTemplate.content.cloneNode(true));
			const finalScore = mount.querySelector('#final-score')!;
			finalScore.textContent = `I scored ${correctAnswers}/${questions.length} on ${JSONWTF_BASE_URL} and all I got was this lousy text to share on social media`;
		}

		function createExplanationFragment(text: string) {
			const frag = document.createDocumentFragment();
			const re = /`([^`]+)`/gu;
			let lastIndex = 0;
			let match: RegExpExecArray | null;
			while ((match = re.exec(text)) !== null) {
				if (match.index > lastIndex) {
					frag.append(
						document.createTextNode(text.slice(lastIndex, match.index)),
					);
				}
				const code = document.createElement('code');
				code.textContent = match[1] ?? '';
				frag.append(code);
				lastIndex = match.index + match[0].length;
			}
			if (lastIndex < text.length) {
				frag.append(document.createTextNode(text.slice(lastIndex)));
			}
			return frag;
		}

		function getValidOrNotText(option: Option): string {
			switch (option) {
				case 'valid':
					return 'This is valid';
				case 'invalid':
					return 'This is invalid';
				case 'maybe valid':
					return 'This may be valid';
				default:
					throw new Error('Unknown option');
			}
		}
	</script>
</BaseLayout>
