---
import FieldRow from './field-row.astro';
import { FIELD_CONTROL_CLASS } from './field-control-class';
import type { Option } from './option';

export type Props = {
	name: string;
	label: string;
	hint?: string;
	inputmode?: 'numeric';
	pattern?: string;
	datalist?: readonly Option[];
};

const { name, label, hint, inputmode, pattern, datalist } = Astro.props;
const id = name;
const datalistId = datalist === undefined ? undefined : `${id}-datalist`;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<input
		id={id}
		name={name}
		type="text"
		inputmode={inputmode}
		pattern={pattern}
		list={datalistId}
		data-datalist-source={datalistId}
		aria-describedby={hint === undefined ? undefined : `${id}-hint`}
		class={FIELD_CONTROL_CLASS}
	/>
	{
		datalist !== undefined && (
			<Fragment>
				<datalist id={datalistId} />
				<script
					is:inline
					type="application/json"
					id={`${datalistId}-source`}
					set:html={JSON.stringify(datalist)}
				/>
			</Fragment>
		)
	}
</FieldRow>
