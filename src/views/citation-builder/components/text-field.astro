---
import FieldRow from './field-row.astro';
import { fieldClass } from './styles';

// Enabled: a bright, solid, clearly-visible border (opacity-50 on the
// whole element, the previous approach, multiplied with the border's
// own alpha and made it nearly invisible). Disabled: a *dashed* border
// -- a pattern change, not just a color change, so it reads as
// "inactive" on its own without needing an enabled neighbor to compare
// against (a plain lighter/tinted color, tried first, still looked
// like a normal field in isolation) -- plus a background tint and
// dimmed value text. Disabled-ness itself is also exposed to assistive
// tech via the native `disabled` attribute, independent of any of this
// styling. Shared with select-field.astro via styles.ts so both stay in
// sync.

export type Props = {
	id: string;
	name: string;
	label: string;
	hint?: string;
	inputmode?: 'numeric';
	// Native constraint validation, not a display hint like inputmode --
	// so checkValidity() actually rejects non-numeric input before it
	// ever reaches Number() in state/citation-input-builders.ts.
	pattern?: string;
};

const { id, name, label, hint, inputmode, pattern } = Astro.props;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<input
		id={id}
		name={name}
		type="text"
		inputmode={inputmode}
		pattern={pattern}
		aria-describedby={hint === undefined ? undefined : `${id}-hint`}
		class={fieldClass}
	/>
</FieldRow>
