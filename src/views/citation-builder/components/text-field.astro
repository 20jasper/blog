---
import FieldRow from './field-row.astro';

const fieldClass =
	'block w-full min-w-0 max-w-full box-border rounded-md border border-foreground-secondary/40 bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent disabled:cursor-not-allowed disabled:opacity-50';

export type Props = {
	id: string;
	name: string;
	label: string;
	hint?: string;
	inputmode?: 'numeric';
	// Native constraint validation, not a display hint like inputmode --
	// so checkValidity() actually rejects non-numeric input before it
	// ever reaches Number() in state/citation-input-builders.ts.
	pattern?: string;
};

const { id, name, label, hint, inputmode, pattern } = Astro.props;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<input
		id={id}
		name={name}
		type="text"
		inputmode={inputmode}
		pattern={pattern}
		aria-describedby={hint === undefined ? undefined : `${id}-hint`}
		class={fieldClass}
	/>
</FieldRow>
