---
import FieldRow from './field-row.astro';
import FilteredDatalist from './filtered-datalist.astro';
import { FIELD_CONTROL_CLASS } from './field-control-class';
import type { Option } from './option';

export type Props = {
	name: string;
	label: string;
	hint?: string;
	inputmode?: 'numeric';
	pattern?: string;
	datalist?: readonly Option[];
};

const { name, label, hint, inputmode, pattern, datalist } = Astro.props;
const id = name;
const datalistId = `${id}-datalist`;
const describedBy = hint === undefined ? undefined : `${id}-hint`;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	{
		datalist === undefined ? (
			<input
				id={id}
				name={name}
				type="text"
				inputmode={inputmode}
				pattern={pattern}
				aria-describedby={describedBy}
				class={FIELD_CONTROL_CLASS}
			/>
		) : (
			<FilteredDatalist
				id={datalistId}
				options={datalist}
			>
				<input
					id={id}
					name={name}
					type="text"
					inputmode={inputmode}
					pattern={pattern}
					list={datalistId}
					aria-describedby={describedBy}
					class={FIELD_CONTROL_CLASS}
				/>
			</FilteredDatalist>
		)
	}
</FieldRow>
