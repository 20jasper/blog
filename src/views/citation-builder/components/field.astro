---
import SelectField from './select-field.astro';
import TextField from './text-field.astro';
import type { Option } from './option';

type BaseFieldSpec = {
	name: string;
	label: string;
	hint?: string;
};

export type Props =
	| (BaseFieldSpec & {
			kind: 'text';
			inputmode?: 'numeric';
			pattern?: string;
			datalist?: readonly Option[];
	  })
	| (BaseFieldSpec & {
			kind: 'select';
			options: Option[];
	  });

const spec = Astro.props;
---

{spec.kind === 'select' ? <SelectField {...spec} /> : <TextField {...spec} />}
