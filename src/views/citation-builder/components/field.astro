---
import SelectField from './select-field.astro';
import TextField from './text-field.astro';

type BaseFieldSpec = {
	id: string;
	name: string;
	label: string;
	hint?: string;
};

export type Props =
	| (BaseFieldSpec & {
			kind: 'text';
			inputmode?: 'numeric';
			// Native constraint validation, not a display hint like
			// inputmode -- so checkValidity() actually rejects non-numeric
			// input before it ever reaches Number() in
			// state/citation-input-builders.ts.
			pattern?: string;
	  })
	| (BaseFieldSpec & {
			kind: 'select';
			options: { value: string; text: string }[];
	  });

const spec = Astro.props;
---

{spec.kind === 'select' ? <SelectField {...spec} /> : <TextField {...spec} />}
