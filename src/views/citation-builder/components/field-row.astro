---
import { stackClass, labelClass } from './styles';

// Shared row shell for a labeled field -- label above the control,
// optional format hint below the label, stacked in a flex column. Text
// inputs and selects both wrap their control in this so spacing/label
// styling stays in one place.
//
// The hint line reserves one line of height (sm:min-h-4, matching
// text-xs's line-height) only from the sm: breakpoint up, where the
// grid becomes 2 columns (see gridClass in citation-builder.ui.astro)
// and fields land in the same row as an unrelated neighbor -- without a
// fixed reservation there, a field with a hint (or a longer one) pushes
// its own input down relative to the row-mate's, desyncing the two
// columns even though the grid row itself is tall enough for both. On
// the single-column mobile layout there's no row-mate to sync with, so
// an empty hint should collapse instead of leaving a blank gap.
const hintClass = 'text-foreground-secondary text-xs sm:min-h-4';

export type Props = {
	for: string;
	label: string;
	hint?: string;
};

const { for: forId, label, hint } = Astro.props;
---

<div class={stackClass}>
	<label
		for={forId}
		class={labelClass}
		>{label}<span
			class="required-marker text-accent"
			aria-hidden="true"
			hidden
		>
			{' '}*</span
		></label
	>
	<p
		id={`${forId}-hint`}
		class={hintClass}
	>
		{hint}
	</p>
	<slot />
</div>
