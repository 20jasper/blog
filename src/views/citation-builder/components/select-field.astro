---
import FieldRow from './field-row.astro';

export type Props = {
	id: string;
	name: string;
	label: string;
	hint?: string;
	options: { value: string; text: string }[];
};

const { id, name, label, hint, options } = Astro.props;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<div class="relative">
		{
			/* Solid border enabled, dashed border + background tint +
			dimmed text disabled -- see text-field.astro's matching comment
			for why; the base classes here match its <input>. */
		}
		<select
			id={id}
			name={name}
			aria-describedby={hint === undefined ? undefined : `${id}-hint`}
			class="border-foreground-secondary/70 bg-background text-foreground focus:border-accent focus:ring-accent disabled:border-foreground-secondary/50 disabled:bg-foreground-secondary/10 disabled:text-foreground-secondary box-border block w-full max-w-full min-w-0 appearance-none rounded-md border px-3 py-2 pr-8 focus:ring-1 focus:outline-none disabled:cursor-not-allowed disabled:border-dashed"
		>
			{
				options.map((option) => (
					<option value={option.value}>{option.text}</option>
				))
			}
		</select>
		<span
			class="text-foreground-secondary pointer-events-none absolute inset-y-0 right-3 flex items-center"
			aria-hidden="true"
			>▾</span
		>
	</div>
</FieldRow>
