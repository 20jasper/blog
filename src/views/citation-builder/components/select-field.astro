---
import FieldRow from './field-row.astro';
import { fieldClass } from './styles';

// Solid border enabled, dashed border + background tint + dimmed text
// disabled -- see text-field.astro's matching comment for why.
const selectClass = `${fieldClass} appearance-none pr-8`;
const chevronClass =
	'text-foreground-secondary pointer-events-none absolute inset-y-0 right-3 flex items-center';

export type Props = {
	id: string;
	name: string;
	label: string;
	hint?: string;
	options: { value: string; text: string }[];
};

const { id, name, label, hint, options } = Astro.props;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<div class="relative">
		<select
			id={id}
			name={name}
			aria-describedby={hint === undefined ? undefined : `${id}-hint`}
			class={selectClass}
		>
			{
				options.map((option) => (
					<option value={option.value}>{option.text}</option>
				))
			}
		</select>
		<span
			class={chevronClass}
			aria-hidden="true"
			>▾</span
		>
	</div>
</FieldRow>
