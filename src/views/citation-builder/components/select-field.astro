---
import FieldRow from './field-row.astro';

// Border stays at full alpha in both states -- see text-field.astro's
// matching comment for why (blanket opacity-50 was multiplying with the
// border's own alpha and making it nearly invisible once disabled).
const fieldClass =
	'block w-full min-w-0 max-w-full box-border rounded-md border border-foreground-secondary/70 bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent disabled:cursor-not-allowed disabled:text-foreground-secondary';
const selectClass = `${fieldClass} appearance-none pr-8`;
const chevronClass =
	'text-foreground-secondary pointer-events-none absolute inset-y-0 right-3 flex items-center';

export type Props = {
	id: string;
	name: string;
	label: string;
	hint?: string;
	options: { value: string; text: string }[];
};

const { id, name, label, hint, options } = Astro.props;
---

<FieldRow
	for={id}
	label={label}
	hint={hint}
>
	<div class="relative">
		<select
			id={id}
			name={name}
			aria-describedby={hint === undefined ? undefined : `${id}-hint`}
			class={selectClass}
		>
			{
				options.map((option) => (
					<option value={option.value}>{option.text}</option>
				))
			}
		</select>
		<span
			class={chevronClass}
			aria-hidden="true"
			>▾</span
		>
	</div>
</FieldRow>
