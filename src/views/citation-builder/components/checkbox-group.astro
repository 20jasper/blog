---
import ChoiceGroup from './choice-group.astro';
import Choice from './choice.astro';

export type Props = {
	label: string;
	options: { name: string; text: string; checked?: boolean }[];
};

const { label, options } = Astro.props;
---

<ChoiceGroup label={label}>
	{
		options.map((option) => (
			<Choice
				type="checkbox"
				name={option.name}
				checked={option.checked}
			>
				{option.text}
			</Choice>
		))
	}
</ChoiceGroup>
