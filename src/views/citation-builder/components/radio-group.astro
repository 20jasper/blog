---
import ChoiceGroup from './choice-group.astro';
import Choice from './choice.astro';
import type { Option } from './option';

export type Props = {
	label: string;
	name: string;
	options: (Option & { checked?: boolean })[];
};

const { label, name, options } = Astro.props;
---

<ChoiceGroup label={label}>
	{options.map((option) => (
		<Choice
			type="radio"
			name={name}
			value={option.value}
			checked={option.checked}
		>
			{option.text}
		</Choice>
	))}
</ChoiceGroup>
