---
import Button from '@components/button.astro';
import {
	AVAILABILITIES,
	CODE_ABBREVIATIONS,
	CODE_TYPES,
	COURT_ABBREVIATIONS,
	HISTORY_PHRASES,
	MODES,
	MONTHS,
	REPORTER_ABBREVIATIONS,
	SIGNALS,
	SOURCE_TYPES,
} from '@components/citation-builder/state';
import CheckboxGroup from './components/checkbox-group.astro';
import Choice from './components/choice.astro';
import Field from './components/field.astro';
import FieldGrid from './components/field-grid.astro';
import Fieldset from './components/fieldset.astro';
import RadioGroup from './components/radio-group.astro';
import SelectField from './components/select-field.astro';
import type { Props as FieldSpec } from './components/field.astro';
import { EXAMPLES } from './examples';

const FORM_ID = 'citation-builder-form';

function radioOptions<T extends { value: string; text: string }>(
	items: readonly T[],
	defaultValue: T['value'],
) {
	return items.map((item) => ({
		...item,
		checked: item.value === defaultValue,
	}));
}

const SOURCE_TYPE_OPTIONS = radioOptions(SOURCE_TYPES, 'reported');
const MODE_OPTIONS = radioOptions(MODES, 'full');

const EXAMPLE_OPTIONS = EXAMPLES.map((example) => ({
	value: example.sourceType,
	text: example.label,
}));
const AVAILABILITY_OPTIONS = radioOptions(AVAILABILITIES, 'database');
const CODE_TYPE_OPTIONS = radioOptions(CODE_TYPES, 'official');

const EMPHASIS_OPTIONS = [
	{ value: 'italic', text: 'Italic', checked: true },
	{ value: 'underline', text: 'Underline' },
];

const SPAN_SEPARATOR_OPTIONS = [
	{ value: 'hyphen', text: 'Hyphen (208-14)', checked: true },
	{ value: 'en-dash', text: 'En dash (208–14)' },
];

const CITATION_FORM_FIELDS: FieldSpec[] = [
	{
		kind: 'select',
		name: 'nameVariant',
		label: 'Name variant',
		hint: 'Which party name the short form uses',
		options: [
			{ value: 'full', text: 'Full name' },
			{ value: 'party1', text: 'Party 1' },
			{ value: 'party2', text: 'Party 2' },
			{ value: 'none', text: 'No name' },
		],
	},
	{
		kind: 'select',
		name: 'signal',
		label: 'Introductory signal',
		options: SIGNALS.map((signal) => ({
			value: signal.value,
			text: signal.text,
		})),
	},
];

const CASE_IDENTITY_FIELDS: FieldSpec[] = [
	{
		kind: 'select',
		name: 'caseType',
		label: 'Case type',
		options: [
			{ value: 'v', text: 'v.' },
			{ value: 'in-re', text: 'In re' },
			{ value: 'ex-parte', text: 'Ex parte' },
		],
	},
	{
		kind: 'text',
		name: 'party1',
		label: 'Party 1 (abbreviated)',
	},
	{
		kind: 'text',
		name: 'party2',
		label: 'Party 2 (abbreviated)',
	},
	{
		kind: 'text',
		name: 'court',
		label: 'Court (abbreviated)',
		hint: 'e.g., Ohio Ct. App., 2d Cir.',
		datalist: COURT_ABBREVIATIONS,
	},
	{
		kind: 'text',
		name: 'pincite',
		label: 'Pincite',
		hint: 'Page, range, or list, e.g. 214, 208-14, or 490, 495',
	},
	{
		kind: 'text',
		name: 'year',
		label: 'Decision year',
		inputmode: 'numeric',
		pattern: '\\d+',
	},
	{
		kind: 'text',
		name: 'weightOfAuthority',
		label: 'Weight of authority parenthetical',
		hint: 'e.g. Marshall, J., dissenting -- no parens needed; separate multiple with ;',
	},
	{
		kind: 'select',
		name: 'historyPhrase',
		label: 'Prior/subsequent history phrase',
		options: [
			{ value: '', text: 'None' },
			...HISTORY_PHRASES.map((phrase) => ({
				value: phrase.value,
				text: phrase.text,
			})),
		],
	},
	{
		kind: 'text',
		name: 'historyCitation',
		label: 'Prior/subsequent history citation',
		hint: 'Case name or citation',
	},
];

const REPORTED_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		name: 'volume',
		label: 'Volume',
	},
	{
		kind: 'text',
		name: 'reporter',
		label: 'Reporter',
		hint: 'Abbreviated series, e.g. N.E.3d',
		datalist: REPORTER_ABBREVIATIONS,
	},
	{
		kind: 'text',
		name: 'firstPage',
		label: 'First page',
		hint: 'First page of the opinion in the reporter',
	},
];

const UNREPORTED_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		name: 'docket',
		label: 'Docket number',
		hint: 'e.g. 05-1234 -- "No. " is added automatically',
	},
	{
		kind: 'text',
		name: 'databaseId',
		label: 'Database identifier',
		hint: 'e.g. 2005 WL 2709572',
	},
	{
		kind: 'text',
		name: 'url',
		label: 'Opinion URL',
		hint: 'Court website URL -- only for opinions with no database or reporter',
	},
	{
		kind: 'select',
		name: 'month',
		label: 'Month decided',
		options: MONTHS.map((month) => ({ value: month, text: month })),
	},
	{
		kind: 'text',
		name: 'day',
		label: 'Day decided',
		inputmode: 'numeric',
		pattern: '\\d+',
	},
];

const STATUTE_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		name: 'popularName',
		label: 'Popular name',
		hint: 'e.g. Consumer Credit Code',
	},
	{
		kind: 'text',
		name: 'originalSection',
		label: 'Original section number',
		hint: 'Section in the original act, not the code -- needs a popular name',
	},
	{
		kind: 'text',
		name: 'title',
		label: 'Title',
		hint: 'e.g. 17 -- precedes the code, no comma',
	},
	{
		kind: 'text',
		name: 'code',
		label: 'Code abbreviation',
		hint: 'e.g. U.S.C., U.S.C.A.',
		datalist: CODE_ABBREVIATIONS,
	},
	{
		kind: 'text',
		name: 'section',
		label: 'Section',
		hint: 'e.g. 107 or § 107 -- "§ " is added automatically',
	},
	{
		kind: 'text',
		name: 'publisher',
		label: 'Publisher',
		hint: 'e.g. West, LexisNexis -- annotated codes only',
	},
	{
		kind: 'text',
		name: 'supplementDesignation',
		label: 'Supplement designation',
		hint: 'e.g. Supp. I',
	},
	{
		kind: 'text',
		name: 'supplementYear',
		label: 'Supplement year',
		inputmode: 'numeric',
		pattern: '\\d+',
	},
];
---

<div class="mb-4 flex flex-wrap items-end gap-3">
	<SelectField
		name="example"
		label="Example"
		options={EXAMPLE_OPTIONS}
	/>
	<Button
		id="load-example-button"
		type="button"
		variant="muted"
	>
		Load example
	</Button>
</div>

<p class="text-foreground-secondary mb-2 text-sm">
	<span
		class="text-accent"
		aria-hidden="true"
		>*</span
	> required
</p>
<form
	id={FORM_ID}
	class="flex w-full max-w-full flex-col gap-6"
>
	<Fieldset legend="Citation form">
		<FieldGrid>
			<RadioGroup
				label="Source type"
				name="sourceType"
				options={SOURCE_TYPE_OPTIONS}
			/>
			<RadioGroup
				label="Mode"
				name="mode"
				options={MODE_OPTIONS}
			/>
			{CITATION_FORM_FIELDS.map((field) => <Field {...field} />)}
			<div class="flex w-full flex-col gap-1">
				<Choice
					type="checkbox"
					name="id"
				>
					This citation immediately follows one to the same source (Id.)
				</Choice>
			</div>
			<RadioGroup
				label="Typeface"
				name="emphasis"
				options={EMPHASIS_OPTIONS}
			/>
			<RadioGroup
				label="Span separator"
				name="spanSeparator"
				options={SPAN_SEPARATOR_OPTIONS}
			/>
		</FieldGrid>
	</Fieldset>

	<Fieldset legend="Case identity">
		<FieldGrid>
			{CASE_IDENTITY_FIELDS.map((field) => <Field {...field} />)}
		</FieldGrid>
	</Fieldset>

	<Fieldset legend="Reported case">
		<FieldGrid>
			{REPORTED_FIELDS.map((field) => <Field {...field} />)}
		</FieldGrid>
	</Fieldset>

	<Fieldset legend="Unreported case">
		<FieldGrid>
			<RadioGroup
				label="Availability"
				name="availability"
				options={AVAILABILITY_OPTIONS}
			/>
			{UNREPORTED_FIELDS.map((field) => <Field {...field} />)}
		</FieldGrid>
	</Fieldset>

	<Fieldset legend="Statute">
		<FieldGrid>
			<RadioGroup
				label="Code type"
				name="codeType"
				options={CODE_TYPE_OPTIONS}
			/>
			<CheckboxGroup
				label="Material location"
				options={[
					{ name: 'materialLocationMain', text: 'Main volume', checked: true },
					{ name: 'materialLocationSupplement', text: 'Supplement' },
				]}
			/>
			{STATUTE_FIELDS.map((field) => <Field {...field} />)}
		</FieldGrid>
	</Fieldset>
</form>

<div
	role="region"
	aria-label="Citation result"
	class="border-foreground-secondary/30 bg-background-secondary sticky bottom-0 mt-6 rounded-2xl border px-4 py-3"
>
	<p class="text-foreground text-xs font-semibold tracking-wide uppercase">
		Citation
	</p>
	<output
		for={FORM_ID}
		class="mt-1 block max-h-24 w-full max-w-full overflow-y-auto text-lg break-words"
	></output>
	<div class="mt-3 flex flex-wrap gap-3">
		<Button
			id="clear-button"
			type="button"
			variant="flat"
		>
			Clear
		</Button>
		<Button
			id="copy-button"
			type="submit"
			form={FORM_ID}
			variant="flat"
		>
			Copy
		</Button>
		<Button
			id="save-button"
			type="button"
			variant="flat"
			aria-describedby="save-status"
		>
			Save citation
		</Button>
	</div>
	<p
		id="save-status"
		aria-live="polite"
		class="text-foreground-secondary mt-2 text-sm"
	>
	</p>
</div>
