---
import Button from '@components/button.astro';
import Choice from './components/choice.astro';
import SelectField from './components/select-field.astro';
import TextField from './components/text-field.astro';
import { ids } from './ids';
import { MONTHS } from '@components/citation-builder/domain/types';

const fieldsetClass = 'w-full max-w-full border-0 p-0';
const legendClass =
	'border-foreground-secondary/30 text-foreground mb-3 w-full border-b p-0 pb-2 text-lg font-semibold';
const gridClass = 'grid w-full max-w-full grid-cols-1 gap-4 sm:grid-cols-2';
const labelClass = 'text-base font-semibold text-foreground';
const choiceRowClass = 'flex w-full flex-col gap-1';

const CASE_TYPE_OPTIONS = [
	{ value: 'v', text: 'v.' },
	{ value: 'in-re', text: 'In re' },
	{ value: 'ex-parte', text: 'Ex parte' },
];

const NAME_VARIANT_OPTIONS = [
	{ value: 'full', text: 'Full name' },
	{ value: 'party1', text: 'Party 1' },
	{ value: 'party2', text: 'Party 2' },
	{ value: 'none', text: 'No name' },
];

const MONTH_OPTIONS = MONTHS.map((month) => ({ value: month, text: month }));

const MATERIAL_LOCATION_OPTIONS = [
	{ value: 'main-volume', text: 'Main volume' },
	{ value: 'both', text: 'Both' },
	{ value: 'supplement-only', text: 'Supplement only' },
];
---

<div class="mb-4 flex flex-wrap items-center gap-3">
	<span class="text-foreground-secondary text-sm">Examples:</span>
	<Button
		type="button"
		class="!bg-background-secondary/60 hover:!bg-background-secondary"
		>Dayton v. Stewart (reported)</Button
	>
	<Button
		type="button"
		class="!bg-background-secondary/60 hover:!bg-background-secondary"
		>State v. Lucko (unreported)</Button
	>
	<Button
		type="button"
		class="!bg-background-secondary/60 hover:!bg-background-secondary"
		>Ohio Rev. Code Ann. (statute)</Button
	>
</div>

<p class="text-foreground-secondary mb-2 text-sm">
	<span
		class="text-accent"
		aria-hidden="true"
		>*</span
	> required
</p>
<form
	id={ids.form}
	class="flex w-full max-w-full flex-col gap-6"
>
	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Source</legend>
		<div class={choiceRowClass}>
			<span class={labelClass}>Source type</span>
			<div class="flex flex-col gap-2">
				<Choice
					type="radio"
					name="sourceType"
					value="reported"
					checked
					>Reported case</Choice
				>
				<Choice
					type="radio"
					name="sourceType"
					value="unreported"
					>Unreported case</Choice
				>
				<Choice
					type="radio"
					name="sourceType"
					value="statute"
					>Statute</Choice
				>
			</div>
		</div>
	</fieldset>

	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Case identity</legend>
		<div class={gridClass}>
			<SelectField
				id={ids.caseType}
				name="caseType"
				label="Case type"
				options={CASE_TYPE_OPTIONS}
			/>
			<TextField
				id={ids.party1}
				name="party1"
				label="Party 1 (abbreviated)"
			/>
			<TextField
				id={ids.party2}
				name="party2"
				label="Party 2 (abbreviated)"
			/>
			{
				/* Freeform, unvalidated (§6) -- the label/hint just state the
			expected format; not a validation disclaimer. */
			}
			<TextField
				id={ids.court}
				name="court"
				label="Court (abbreviated)"
				hint="e.g., Ohio Ct. App., 2d Cir."
			/>
			<TextField
				id={ids.pincite}
				name="pincite"
				label="Pincite"
				hint="Page, range, or list, e.g. 214, 208-14, or 490, 495"
			/>
		</div>
	</fieldset>

	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Reported case</legend>
		<div class={gridClass}>
			<TextField
				id={ids.volume}
				name="volume"
				label="Volume"
				hint="Reporter volume number"
			/>
			<TextField
				id={ids.reporter}
				name="reporter"
				label="Reporter"
				hint="Abbreviated series, e.g. N.E.3d"
			/>
			<TextField
				id={ids.firstPage}
				name="firstPage"
				label="First page"
				hint="First page of the opinion in the reporter"
			/>
			<TextField
				id={ids.year}
				name="year"
				label="Decision year"
				hint="Year the case was decided"
				inputmode="numeric"
				pattern="[0-9]+"
			/>
		</div>
	</fieldset>

	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Unreported case</legend>
		<div class={gridClass}>
			<div class={choiceRowClass}>
				<span class={labelClass}>Availability</span>
				<div class="flex flex-col gap-2">
					<Choice
						type="radio"
						name="availability"
						value="database"
						checked
					>
						In electronic database
					</Choice>
					<Choice
						type="radio"
						name="availability"
						value="slip-opinion"
					>
						Slip opinion only
					</Choice>
				</div>
			</div>
			<TextField
				id={ids.docketNumber}
				name="docketNumber"
				label="Docket number"
				hint={'"No." is added automatically'}
			/>
			<TextField
				id={ids.databaseIdentifier}
				name="databaseIdentifier"
				label="Database identifier"
				hint="e.g., 2021 WL 4269952"
			/>
			<SelectField
				id={ids.month}
				name="month"
				label="Month"
				options={MONTH_OPTIONS}
			/>
			<TextField
				id={ids.day}
				name="day"
				label="Day"
				inputmode="numeric"
				pattern="[0-9]+"
			/>
			<TextField
				id={ids.dateYear}
				name="dateYear"
				label="Opinion year"
				hint="Year the opinion was issued"
				inputmode="numeric"
				pattern="[0-9]+"
			/>
		</div>
	</fieldset>

	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Statute</legend>
		<div class={gridClass}>
			<div class={choiceRowClass}>
				<span class={labelClass}>Code type</span>
				<div class="flex flex-col gap-2">
					<Choice
						type="radio"
						name="codeType"
						value="official"
						checked
					>
						Official code
					</Choice>
					<Choice
						type="radio"
						name="codeType"
						value="annotated"
					>
						Annotated / unofficial code
					</Choice>
				</div>
			</div>
			<TextField
				id={ids.codeAbbreviation}
				name="codeAbbreviation"
				label="Code abbreviation"
				hint="e.g., Ohio Rev. Code Ann., U.S.C."
			/>
			<TextField
				id={ids.section}
				name="section"
				label="Section"
				hint={'"§" is added automatically'}
			/>
			<TextField
				id={ids.publisher}
				name="publisher"
				label="Publisher"
				hint="Required for annotated codes, e.g. West"
			/>
			<SelectField
				id={ids.materialLocation}
				name="materialLocation"
				label="Material location"
				hint="Where the cited material appears"
				options={MATERIAL_LOCATION_OPTIONS}
			/>
			<TextField
				id={ids.codeYear}
				name="codeYear"
				label="Code edition year"
				inputmode="numeric"
				pattern="[0-9]+"
			/>
			<TextField
				id={ids.supplementDesignation}
				name="supplementDesignation"
				label="Supplement designation"
				hint="e.g., Supp., Supp. I, Supp. V"
			/>
			<TextField
				id={ids.supplementYear}
				name="supplementYear"
				label="Supplement year"
				inputmode="numeric"
				pattern="[0-9]+"
			/>
		</div>
	</fieldset>

	<fieldset class={fieldsetClass}>
		<legend class={legendClass}>Citation form</legend>
		<div class={gridClass}>
			<div class={choiceRowClass}>
				<span class={labelClass}>Mode</span>
				<div class="flex flex-col gap-2">
					<Choice
						type="radio"
						name="mode"
						value="full"
						checked
						>Full citation</Choice
					>
					<Choice
						type="radio"
						name="mode"
						value="short"
						>Short form</Choice
					>
				</div>
			</div>
			<SelectField
				id={ids.nameVariant}
				name="nameVariant"
				label="Name variant"
				hint="Which party name the short form uses"
				options={NAME_VARIANT_OPTIONS}
			/>
			<div class={choiceRowClass}>
				<Choice
					type="checkbox"
					name="id"
				>
					This citation immediately follows one to the same source (Id.)
				</Choice>
			</div>
			<div class={choiceRowClass}>
				<span class={labelClass}>Typeface</span>
				<div class="flex flex-col gap-2">
					<Choice
						type="radio"
						name="emphasis"
						value="italic"
						checked
						>Italic</Choice
					>
					<Choice
						type="radio"
						name="emphasis"
						value="underline"
						>Underline</Choice
					>
				</div>
			</div>
			<div class={choiceRowClass}>
				<span class={labelClass}>Span separator</span>
				<div class="flex flex-col gap-2">
					<Choice
						type="radio"
						name="spanSeparator"
						value="hyphen"
						checked
						>Hyphen (208-14)</Choice
					>
					<Choice
						type="radio"
						name="spanSeparator"
						value="en-dash"
						>En dash (208–14)</Choice
					>
				</div>
			</div>
		</div>
	</fieldset>
</form>

{
	/* Sticky so Clear/Copy/the current result stay reachable without
	scrolling back down through ~20 fields across four fieldsets (or up,
	if you're mid-form). Sticky is CSS-only -- it doesn't move these
	elements in the DOM, so tab order and a screen reader's linear
	reading order are unaffected; role="region" just gives AT users a
	direct landmark to jump to instead of finding it by depth. The
	<output> lives only here (not duplicated up by the form) since it
	already carries an implicit role="status" live region -- a second
	copy would double-announce every live update. */
}
<div
	role="region"
	aria-label="Citation result"
	class="border-foreground-secondary/30 bg-background-secondary sticky bottom-0 mt-6 rounded-2xl border px-4 py-3"
>
	<p class="text-foreground text-xs font-semibold tracking-wide uppercase">
		Citation
	</p>
	<output
		for={ids.form}
		class="mt-1 block max-h-24 w-full max-w-full overflow-y-auto text-lg break-words"
	></output>
	<div class="mt-3 flex flex-wrap gap-3">
		<Button
			type="button"
			class="!bg-background hover:!bg-background/80"
			>Clear</Button
		>
		<Button
			type="submit"
			form={ids.form}
			class="!bg-background hover:!bg-background/80"
			>Copy</Button
		>
	</div>
</div>
