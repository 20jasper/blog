---
import Button from '@components/button.astro';
import Choice from './components/choice.astro';
import Field from './components/field.astro';
import Fieldset from './components/fieldset.astro';
import RadioGroup from './components/radio-group.astro';
import SelectField from './components/select-field.astro';
import { ids } from './ids';
import { MONTHS } from '@components/citation-builder/domain/types';
import type { FieldSpec } from './components/field-spec';

const gridClass = 'grid w-full max-w-full grid-cols-1 gap-4 sm:grid-cols-2';
// Shared by Clear and Copy -- Load example uses the default Button look.
const outputButtonClass = '!bg-background hover:!bg-background/80';

const MONTH_OPTIONS = MONTHS.map((month) => ({ value: month, text: month }));

const EXAMPLE_OPTIONS = [
	{ value: 'reported', text: 'Dayton v. Stewart (reported)' },
	{ value: 'unreported', text: 'State v. Lucko (unreported)' },
	{ value: 'statute', text: 'Ohio Rev. Code Ann. (statute)' },
];

// Radio groups, one array per group -- see components/radio-group.astro.
const SOURCE_TYPE_OPTIONS = [
	{ value: 'reported', text: 'Reported case', checked: true },
	{ value: 'unreported', text: 'Unreported case' },
	{ value: 'statute', text: 'Statute' },
];

const MODE_OPTIONS = [
	{ value: 'full', text: 'Full citation', checked: true },
	{ value: 'short', text: 'Short form' },
];

const AVAILABILITY_OPTIONS = [
	{ value: 'database', text: 'In electronic database', checked: true },
	{ value: 'slip-opinion', text: 'Slip opinion only' },
];

const CODE_TYPE_OPTIONS = [
	{ value: 'official', text: 'Official code', checked: true },
	{ value: 'annotated', text: 'Annotated / unofficial code' },
];

const EMPHASIS_OPTIONS = [
	{ value: 'italic', text: 'Italic', checked: true },
	{ value: 'underline', text: 'Underline' },
];

const SPAN_SEPARATOR_OPTIONS = [
	{ value: 'hyphen', text: 'Hyphen (208-14)', checked: true },
	{ value: 'en-dash', text: 'En dash (208–14)' },
];

// Field lists, one array per fieldset -- see components/field.astro and
// field-spec.ts. Each fieldset's markup below is just `{LIST.map((field)
// => <Field {...field} />)}` instead of one hand-written <TextField>/
// <SelectField> per field.
const CITATION_FORM_FIELDS: FieldSpec[] = [
	{
		kind: 'select',
		id: ids.nameVariant,
		name: 'nameVariant',
		label: 'Name variant',
		hint: 'Which party name the short form uses',
		options: [
			{ value: 'full', text: 'Full name' },
			{ value: 'party1', text: 'Party 1' },
			{ value: 'party2', text: 'Party 2' },
			{ value: 'none', text: 'No name' },
		],
	},
];

const CASE_IDENTITY_FIELDS: FieldSpec[] = [
	{
		kind: 'select',
		id: ids.caseType,
		name: 'caseType',
		label: 'Case type',
		options: [
			{ value: 'v', text: 'v.' },
			{ value: 'in-re', text: 'In re' },
			{ value: 'ex-parte', text: 'Ex parte' },
		],
	},
	{
		kind: 'text',
		id: ids.party1,
		name: 'party1',
		label: 'Party 1 (abbreviated)',
	},
	{
		kind: 'text',
		id: ids.party2,
		name: 'party2',
		label: 'Party 2 (abbreviated)',
	},
	// Freeform, unvalidated (§6) -- the hint states the expected format,
	// not a validation disclaimer.
	{
		kind: 'text',
		id: ids.court,
		name: 'court',
		label: 'Court (abbreviated)',
		hint: 'e.g., Ohio Ct. App., 2d Cir.',
	},
	{
		kind: 'text',
		id: ids.pincite,
		name: 'pincite',
		label: 'Pincite',
		hint: 'Page, range, or list, e.g. 214, 208-14, or 490, 495',
	},
];

const REPORTED_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		id: ids.volume,
		name: 'volume',
		label: 'Volume',
		hint: 'Reporter volume number',
	},
	{
		kind: 'text',
		id: ids.reporter,
		name: 'reporter',
		label: 'Reporter',
		hint: 'Abbreviated series, e.g. N.E.3d',
	},
	{
		kind: 'text',
		id: ids.firstPage,
		name: 'firstPage',
		label: 'First page',
		hint: 'First page of the opinion in the reporter',
	},
	{
		kind: 'text',
		id: ids.year,
		name: 'year',
		label: 'Decision year',
		hint: 'Year the case was decided',
		inputmode: 'numeric',
		pattern: '[0-9]+',
	},
];

const UNREPORTED_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		id: ids.docketNumber,
		name: 'docketNumber',
		label: 'Docket number',
		hint: '"No." is added automatically',
	},
	{
		kind: 'text',
		id: ids.databaseIdentifier,
		name: 'databaseIdentifier',
		label: 'Database identifier',
		hint: 'e.g., 2021 WL 4269952',
	},
	{
		kind: 'select',
		id: ids.month,
		name: 'month',
		label: 'Month',
		options: MONTH_OPTIONS,
	},
	{
		kind: 'text',
		id: ids.day,
		name: 'day',
		label: 'Day',
		inputmode: 'numeric',
		pattern: '[0-9]+',
	},
	{
		kind: 'text',
		id: ids.dateYear,
		name: 'dateYear',
		label: 'Opinion year',
		hint: 'Year the opinion was issued',
		inputmode: 'numeric',
		pattern: '[0-9]+',
	},
];

const STATUTE_FIELDS: FieldSpec[] = [
	{
		kind: 'text',
		id: ids.codeAbbreviation,
		name: 'codeAbbreviation',
		label: 'Code abbreviation',
		hint: 'e.g., Ohio Rev. Code Ann., U.S.C.',
	},
	{
		kind: 'text',
		id: ids.section,
		name: 'section',
		label: 'Section',
		hint: '"§" is added automatically',
	},
	{
		kind: 'text',
		id: ids.publisher,
		name: 'publisher',
		label: 'Publisher',
		hint: 'Required for annotated codes, e.g. West',
	},
	{
		kind: 'select',
		id: ids.materialLocation,
		name: 'materialLocation',
		label: 'Material location',
		hint: 'Where the cited material appears',
		options: [
			{ value: 'main-volume', text: 'Main volume' },
			{ value: 'both', text: 'Both' },
			{ value: 'supplement-only', text: 'Supplement only' },
		],
	},
	{
		kind: 'text',
		id: ids.codeYear,
		name: 'codeYear',
		label: 'Code edition year',
		inputmode: 'numeric',
		pattern: '[0-9]+',
	},
	{
		kind: 'text',
		id: ids.supplementDesignation,
		name: 'supplementDesignation',
		label: 'Supplement designation',
		hint: 'e.g., Supp., Supp. I, Supp. V',
	},
	{
		kind: 'text',
		id: ids.supplementYear,
		name: 'supplementYear',
		label: 'Supplement year',
		inputmode: 'numeric',
		pattern: '[0-9]+',
	},
];
---

<div class="mb-4 flex flex-wrap items-end gap-3">
	<SelectField
		id={ids.exampleSelect}
		name="example"
		label="Example"
		options={EXAMPLE_OPTIONS}
	/>
	<Button
		type="button"
		class="!bg-background-secondary/60 hover:!bg-background-secondary"
		>Load example</Button
	>
</div>

<p class="text-foreground-secondary mb-2 text-sm">
	<span
		class="text-accent"
		aria-hidden="true"
		>*</span
	> required
</p>
<form
	id={ids.form}
	class="flex w-full max-w-full flex-col gap-6"
>
	<Fieldset legend="Source">
		<RadioGroup
			label="Source type"
			name="sourceType"
			options={SOURCE_TYPE_OPTIONS}
		/>
	</Fieldset>

	{
		/* Mode (and the display controls next to it) determine which
		fields below are required/optional/not-used, so it's chosen before
		the fields it affects rather than after them. */
	}
	<Fieldset legend="Citation form">
		<div class={gridClass}>
			<RadioGroup
				label="Mode"
				name="mode"
				options={MODE_OPTIONS}
			/>
			{CITATION_FORM_FIELDS.map((field) => <Field {...field} />)}
			<div class="flex w-full flex-col gap-1">
				<Choice
					type="checkbox"
					name="id"
				>
					This citation immediately follows one to the same source (Id.)
				</Choice>
			</div>
			<RadioGroup
				label="Typeface"
				name="emphasis"
				options={EMPHASIS_OPTIONS}
			/>
			<RadioGroup
				label="Span separator"
				name="spanSeparator"
				options={SPAN_SEPARATOR_OPTIONS}
			/>
		</div>
	</Fieldset>

	<Fieldset
		legend="Case identity"
		visibleFor="reported unreported"
	>
		<div class={gridClass}>
			{CASE_IDENTITY_FIELDS.map((field) => <Field {...field} />)}
		</div>
	</Fieldset>

	<Fieldset
		legend="Reported case"
		visibleFor="reported"
	>
		<div class={gridClass}>
			{REPORTED_FIELDS.map((field) => <Field {...field} />)}
		</div>
	</Fieldset>

	<Fieldset
		legend="Unreported case"
		visibleFor="unreported"
	>
		<div class={gridClass}>
			<RadioGroup
				label="Availability"
				name="availability"
				options={AVAILABILITY_OPTIONS}
			/>
			{UNREPORTED_FIELDS.map((field) => <Field {...field} />)}
		</div>
	</Fieldset>

	<Fieldset
		legend="Statute"
		visibleFor="statute"
	>
		<div class={gridClass}>
			<RadioGroup
				label="Code type"
				name="codeType"
				options={CODE_TYPE_OPTIONS}
			/>
			{STATUTE_FIELDS.map((field) => <Field {...field} />)}
		</div>
	</Fieldset>
</form>

{
	/* Sticky so Clear/Copy/the current result stay reachable without
	scrolling back down through ~20 fields across four fieldsets (or up,
	if you're mid-form). Sticky is CSS-only -- it doesn't move these
	elements in the DOM, so tab order and a screen reader's linear
	reading order are unaffected; role="region" just gives AT users a
	direct landmark to jump to instead of finding it by depth. The
	<output> lives only here (not duplicated up by the form) since it
	already carries an implicit role="status" live region -- a second
	copy would double-announce every live update. */
}
<div
	role="region"
	aria-label="Citation result"
	class="border-foreground-secondary/30 bg-background-secondary sticky bottom-0 mt-6 rounded-2xl border px-4 py-3"
>
	<p class="text-foreground text-xs font-semibold tracking-wide uppercase">
		Citation
	</p>
	<output
		for={ids.form}
		class="mt-1 block max-h-24 w-full max-w-full overflow-y-auto text-lg break-words"
	></output>
	<div class="mt-3 flex flex-wrap gap-3">
		<Button
			type="button"
			class={outputButtonClass}
			>Clear</Button
		>
		<Button
			type="submit"
			form={ids.form}
			class={outputButtonClass}
			>Copy</Button
		>
	</div>
</div>
