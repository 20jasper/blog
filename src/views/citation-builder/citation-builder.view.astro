---
import PageLayout from '@layouts/page-layout.astro';
import CitationBuilderUi from './citation-builder.ui.astro';
---

<PageLayout title="Bluebook 22 Citation Generator">
	<h1 class="my-5 text-3xl font-bold">Bluebook 22 Citation Generator</h1>
	<CitationBuilderUi />
	<script>
		import {
			isCaseTypeId,
			type CaseTypeId,
		} from '@components/citation-builder/domain/case-types';
		import { render } from '@components/citation-builder/domain/render';
		import {
			assemble,
			buildCitationInput,
			deriveSelections,
			selectFieldState,
			type CitationFields,
			type DisplayState,
			type Emphasis,
			type FieldRequirement,
			type SpanSeparator,
		} from '@components/citation-builder/state';
		import { createClipboardController } from './clipboard';
		import { queryFormRefs } from './dom-refs';
		import {
			REPORTED_EXAMPLE,
			STATUTE_EXAMPLE,
			UNREPORTED_EXAMPLE,
		} from './examples';
		import { ids } from './ids';

		const form = document.querySelector<HTMLFormElement>(`#${ids.form}`)!;
		const output = document.querySelector('output')!;
		const buttons = Array.from(document.querySelectorAll('button'));
		const clearButton = buttons.find((b) => b.textContent?.trim() === 'Clear')!;
		const reportedExampleButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('Dayton v. Stewart'),
		)!;
		const unreportedExampleButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('State v. Lucko'),
		)!;
		const statuteExampleButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('Ohio Rev. Code Ann.'),
		)!;
		const copyButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('Copy'),
		)!;

		const clipboard = createClipboardController(copyButton, output);

		const {
			caseTypeSelect,
			party1Input,
			party2Input,
			courtInput,
			pinciteInput,
			volumeInput,
			reporterInput,
			firstPageInput,
			yearInput,
			docketNumberInput,
			databaseIdentifierInput,
			monthSelect,
			dayInput,
			dateYearInput,
			nameVariantSelect,
			idCheckbox,
			codeAbbreviationInput,
			sectionInput,
			publisherInput,
			materialLocationSelect,
			codeYearInput,
			supplementDesignationInput,
			supplementYearInput,
		} = queryFormRefs(form);

		function currentSourceType(): 'reported' | 'unreported' | 'statute' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="sourceType"]:checked',
			);
			if (checked?.value === 'unreported') {
				return 'unreported';
			}
			return checked?.value === 'statute' ? 'statute' : 'reported';
		}

		function currentAvailability(): 'database' | 'slip-opinion' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="availability"]:checked',
			);
			return checked?.value === 'slip-opinion' ? 'slip-opinion' : 'database';
		}

		function currentCodeType(): 'official' | 'annotated' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="codeType"]:checked',
			);
			return checked?.value === 'annotated' ? 'annotated' : 'official';
		}

		function currentMaterialLocation():
			'main-volume' | 'both' | 'supplement-only' {
			const { value } = materialLocationSelect;
			return value === 'both' || value === 'supplement-only'
				? value
				: 'main-volume';
		}

		function currentCaseType(): CaseTypeId {
			const { value } = caseTypeSelect;
			return isCaseTypeId(value) ? value : 'v';
		}

		function currentMode(): 'full' | 'short' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="mode"]:checked',
			);
			return checked?.value === 'short' ? 'short' : 'full';
		}

		function currentNameVariant(): 'full' | 'party1' | 'party2' | 'none' {
			const { value } = nameVariantSelect;
			return value === 'party1' || value === 'party2' || value === 'none'
				? value
				: 'full';
		}

		function currentEmphasis(): Emphasis {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="emphasis"]:checked',
			);
			return checked?.value === 'underline' ? 'underline' : 'italic';
		}

		function currentSpanSeparator(): SpanSeparator {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="spanSeparator"]:checked',
			);
			return checked?.value === 'en-dash' ? '–' : '-';
		}

		// The single place the live DOM is read into the pure data shapes
		// (CitationFields, DisplayState) that state/ actually operates on --
		// everything past this point (deriveSelections, buildCitationInput)
		// is DOM-free and unit-tested without a browser.
		function readCitationFields(): CitationFields {
			return {
				sourceType: currentSourceType(),
				caseType: currentCaseType(),
				party1: party1Input.value,
				party2: party2Input.value,
				court: courtInput.value,
				pincite: pinciteInput.value,
				volume: volumeInput.value,
				reporter: reporterInput.value,
				firstPage: firstPageInput.value,
				year: yearInput.value,
				availability: currentAvailability(),
				docketNumber: docketNumberInput.value,
				databaseIdentifier: databaseIdentifierInput.value,
				month: monthSelect.value,
				day: dayInput.value,
				dateYear: dateYearInput.value,
				codeType: currentCodeType(),
				codeAbbreviation: codeAbbreviationInput.value,
				section: sectionInput.value,
				publisher: publisherInput.value,
				materialLocation: currentMaterialLocation(),
				codeYear: codeYearInput.value,
				supplementDesignation: supplementDesignationInput.value,
				supplementYear: supplementYearInput.value,
			};
		}

		function readDisplayState(): DisplayState {
			return {
				mode: currentMode(),
				nameVariant: currentNameVariant(),
				useId: idCheckbox.checked,
				emphasis: currentEmphasis(),
				spanSeparator: currentSpanSeparator(),
			};
		}

		// Toggles both the native `required` attribute (so the browser's own
		// validation -- triggered on Copy, a submit button -- tells the user
		// exactly which field is missing) and the label's visual "*" marker,
		// which is otherwise invisible to disabled fields' labels too.
		function setRequired(
			input: HTMLInputElement | HTMLSelectElement,
			required: boolean,
		): void {
			input.required = required;
			const marker =
				input.labels?.[0]?.querySelector<HTMLElement>('.required-marker');
			if (marker) {
				marker.hidden = !required;
			}
		}

		// Fields stay visible always (§3.5) -- only their disabled state
		// changes, never their visibility, so switching source type/mode
		// never shifts the layout. Every data field's disabled/required
		// state comes from selectFieldState -- the same, already-unit-tested
		// function that derives required/optional/not-used -- rather than a
		// second, hand-rolled copy of the same rules living only here.
		// r[impl name-variant.short-form-only]
		function setFieldRequirement(
			input: HTMLInputElement | HTMLSelectElement,
			requirement: FieldRequirement,
		): void {
			input.disabled = requirement === 'not-used';
			setRequired(input, requirement === 'required');
		}

		// Deliberate departure from §3.5 ("every field always visible") --
		// Reported/Unreported/Statute are mutually exclusive per source type,
		// so showing all three's fields at once is more clutter than most
		// single-page forms carry. Case identity is shared by
		// reported/unreported but entirely not-used for statute, so it hides
		// with statute too. Individual not-used fields *within* a visible
		// fieldset (e.g. Party 2 for In re) still only disable, never hide --
		// that's the §3.5 concern this doesn't touch: a value the user
		// already typed staying visible so it's clear it didn't silently
		// vanish.
		function updateFieldsetVisibility(sourceType: string): void {
			for (const fieldset of form.querySelectorAll<HTMLFieldSetElement>(
				'fieldset[data-visible-for]',
			)) {
				const visibleFor = fieldset.dataset.visibleFor?.split(' ') ?? [];
				fieldset.hidden = !visibleFor.includes(sourceType);
			}
		}

		function updateFieldState(): void {
			const fields = readCitationFields();
			const display = readDisplayState();
			const isShort = display.mode === 'short';
			const isStatute = fields.sourceType === 'statute';

			updateFieldsetVisibility(fields.sourceType);

			const fieldState = selectFieldState(deriveSelections(fields, display));

			setFieldRequirement(caseTypeSelect, fieldState.caseType);
			setFieldRequirement(party1Input, fieldState.party1);
			setFieldRequirement(party2Input, fieldState.party2);
			setFieldRequirement(courtInput, fieldState.court);
			setFieldRequirement(pinciteInput, fieldState.pincite);
			setFieldRequirement(volumeInput, fieldState.volume);
			setFieldRequirement(reporterInput, fieldState.reporter);
			setFieldRequirement(firstPageInput, fieldState.firstPage);
			setFieldRequirement(yearInput, fieldState.year);
			setFieldRequirement(monthSelect, fieldState.month);
			setFieldRequirement(dayInput, fieldState.day);
			setFieldRequirement(dateYearInput, fieldState.dateYear);
			setFieldRequirement(docketNumberInput, fieldState.docketNumber);
			setFieldRequirement(
				databaseIdentifierInput,
				fieldState.databaseIdentifier,
			);
			setFieldRequirement(codeAbbreviationInput, fieldState.codeAbbreviation);
			setFieldRequirement(sectionInput, fieldState.section);
			setFieldRequirement(publisherInput, fieldState.publisher);
			setFieldRequirement(materialLocationSelect, fieldState.materialLocation);
			setFieldRequirement(codeYearInput, fieldState.codeYear);
			setFieldRequirement(
				supplementDesignationInput,
				fieldState.supplementDesignation,
			);
			setFieldRequirement(supplementYearInput, fieldState.supplementYear);

			// Name variant / Id.: display controls, not CitationFields data --
			// selectFieldState doesn't (and shouldn't) know about them.
			// Statutes have no case name at all (§5.7 V1 simplification), so
			// both stay disabled regardless of mode there.
			nameVariantSelect.disabled = !isShort || idCheckbox.checked || isStatute;
			idCheckbox.disabled = !isShort || isStatute;

			// Id. (ReportedShortFormInput's/UnreportedShortFormInput's 'id'
			// variant) drops the name entirely, and for reported also drops
			// volume/reporter -- neither is modeled in fieldState since it's
			// a display-state choice, not FieldId data.
			if (isShort && idCheckbox.checked) {
				setRequired(party1Input, false);
				setRequired(volumeInput, false);
				setRequired(reporterInput, false);
			}
		}

		function fillInPlaceholder(): void {
			output.textContent = 'Fill in the fields above to generate a citation.';
			clipboard.setCitation(undefined);
		}

		function setCitationOutput(
			segments: Parameters<typeof render>[0],
			emphasis: Emphasis,
		): void {
			const { html, plain } = render(segments, { emphasis });
			output.innerHTML = html;
			clipboard.setCitation({ html, plain });
		}

		// Every field's disabled/required state (set by updateFieldState(),
		// which always runs first in refresh()) already mirrors
		// selectFieldState -- so the browser's own constraint validation is
		// the single source of truth for "is there enough here to render,"
		// rather than a hand-rolled required-fields check per source
		// type/mode.
		function updateOutput(): void {
			if (!form.checkValidity()) {
				fillInPlaceholder();
				return;
			}
			const fields = readCitationFields();
			const display = readDisplayState();
			const segments = assemble(buildCitationInput(fields, display), {
				spanSeparator: display.spanSeparator,
			});
			setCitationOutput(segments, display.emphasis);
		}

		function refresh(): void {
			updateFieldState();
			updateOutput();
		}

		function fillFields(
			entries: [HTMLInputElement | HTMLSelectElement, string][],
		): void {
			for (const [input, value] of entries) {
				input.value = value;
			}
		}

		function checkRadio(name: string, value: string): void {
			form.querySelector<HTMLInputElement>(
				`input[name="${name}"][value="${value}"]`,
			)!.checked = true;
		}

		function fillReportedExample(): void {
			fillFields([
				[caseTypeSelect, REPORTED_EXAMPLE.caseType],
				[party1Input, REPORTED_EXAMPLE.party1],
				[party2Input, REPORTED_EXAMPLE.party2],
				[courtInput, REPORTED_EXAMPLE.court],
				[volumeInput, REPORTED_EXAMPLE.volume],
				[reporterInput, REPORTED_EXAMPLE.reporter],
				[firstPageInput, REPORTED_EXAMPLE.firstPage],
				[pinciteInput, REPORTED_EXAMPLE.pincite],
				[yearInput, REPORTED_EXAMPLE.year],
			]);
		}

		function fillUnreportedExample(): void {
			checkRadio('sourceType', 'unreported');
			fillFields([
				[caseTypeSelect, UNREPORTED_EXAMPLE.caseType],
				[party1Input, UNREPORTED_EXAMPLE.party1],
				[party2Input, UNREPORTED_EXAMPLE.party2],
				[courtInput, UNREPORTED_EXAMPLE.court],
				[docketNumberInput, UNREPORTED_EXAMPLE.docketNumber],
				[databaseIdentifierInput, UNREPORTED_EXAMPLE.databaseIdentifier],
				[pinciteInput, UNREPORTED_EXAMPLE.pincite],
				[monthSelect, UNREPORTED_EXAMPLE.month],
				[dayInput, UNREPORTED_EXAMPLE.day],
				[dateYearInput, UNREPORTED_EXAMPLE.dateYear],
			]);
		}

		function fillStatuteExample(): void {
			checkRadio('sourceType', 'statute');
			checkRadio('codeType', STATUTE_EXAMPLE.codeType);
			fillFields([
				[codeAbbreviationInput, STATUTE_EXAMPLE.codeAbbreviation],
				[sectionInput, STATUTE_EXAMPLE.section],
				[publisherInput, STATUTE_EXAMPLE.publisher],
				[materialLocationSelect, STATUTE_EXAMPLE.materialLocation],
				[codeYearInput, STATUTE_EXAMPLE.codeYear],
			]);
		}

		function resetToDefaults(): void {
			form.reset();
			// Radios/checkboxes reset via their defaultChecked above --
			// blanking their `value` too would corrupt the attribute
			// selectors (like fillUnreportedExample's) rely on to pick a
			// specific option.
			for (const input of form.querySelectorAll<HTMLInputElement>(
				'input:not([type="radio"]):not([type="checkbox"])',
			)) {
				input.value = '';
			}
			caseTypeSelect.value = 'v';
			nameVariantSelect.value = 'full';
			monthSelect.value = '';
		}

		function clearFields(): void {
			resetToDefaults();
			refresh();
		}

		function loadReportedExample(): void {
			resetToDefaults();
			fillReportedExample();
			refresh();
		}

		function loadUnreportedExample(): void {
			resetToDefaults();
			fillUnreportedExample();
			refresh();
		}

		function loadStatuteExample(): void {
			resetToDefaults();
			fillStatuteExample();
			refresh();
		}

		form.addEventListener('input', refresh);
		form.addEventListener('change', refresh);
		clearButton.addEventListener('click', clearFields);
		reportedExampleButton.addEventListener('click', loadReportedExample);
		unreportedExampleButton.addEventListener('click', loadUnreportedExample);
		statuteExampleButton.addEventListener('click', loadStatuteExample);
		// Copy is a submit button (form={ids.form}) so clicking it while a
		// required field is empty triggers the browser's own native
		// validation UI -- pointing straight at the missing field -- instead
		// of a hand-rolled banner. Only reaches here once that passes.
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			void clipboard.copy();
		});

		fillReportedExample();
		refresh();
	</script>
</PageLayout>
