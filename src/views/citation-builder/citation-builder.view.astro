---
import PageLayout from '@layouts/page-layout.astro';
import CitationBuilderUi from './citation-builder.ui.astro';
---

<PageLayout title="Bluebook 22 Citation Generator">
	<h1 class="my-5 text-3xl font-bold">Bluebook 22 Citation Generator</h1>
	<CitationBuilderUi />
	<script>
		import {
			assembleReportedCase,
			assembleReportedShortForm,
			assembleUnreportedCase,
			assembleUnreportedShortForm,
			type ReportedShortFormInput,
			type UnreportedShortFormInput,
		} from '@components/citation-builder/domain/assemble';
		import {
			isCaseTypeId,
			type CaseNameInput,
			type CaseTypeId,
		} from '@components/citation-builder/domain/case-types';
		import { render } from '@components/citation-builder/domain/render';
		import type { Month } from '@components/citation-builder/domain/types';
		import {
			deriveSelections,
			initialCitationFields,
		} from '@components/citation-builder/state/citation-fields';
		import {
			initialDisplayState,
			type Emphasis,
			type SpanSeparator,
		} from '@components/citation-builder/state/display-state';
		import {
			selectFieldState,
			type FieldRequirement,
		} from '@components/citation-builder/state/field-state';
		import { ids } from '@src/views/citation-builder/ids';

		// Reported and unreported (both full + short) are wired up --
		// statute comes later. Prefilled with the golden case from
		// docs/citation-builder/phase-1-spec.md §8.3 so the page shows a
		// working example instead of a blank form.
		const REPORTED_EXAMPLE = {
			caseType: 'v',
			party1: 'Dayton',
			party2: 'Stewart',
			court: 'Ohio Ct. App.',
			volume: '179',
			reporter: 'N.E.3d',
			firstPage: '208',
			pincite: '214',
			year: '2021',
		} as const;

		// State v. Lucko, No. 2021CA0007, 2021 WL 4269952, at *1-2 (Ohio Ct.
		// App. Sept. 17, 2021) -- the unreported golden case from the same
		// spec section, offered as a second Example button so a user who
		// never switches source type still sees what the unreported flow
		// (star pages, docket normalization, date assembly) actually
		// produces.
		const UNREPORTED_EXAMPLE = {
			caseType: 'v',
			party1: 'State',
			party2: 'Lucko',
			court: 'Ohio Ct. App.',
			docketNumber: '2021CA0007',
			databaseIdentifier: '2021 WL 4269952',
			pincite: '1-2',
			month: 'Sept.',
			day: '17',
			dateYear: '2021',
		} as const;

		const form = document.querySelector<HTMLFormElement>(`#${ids.form}`)!;
		const output = document.querySelector('output')!;
		const buttons = Array.from(document.querySelectorAll('button'));
		const clearButton = buttons.find((b) => b.textContent?.trim() === 'Clear')!;
		const reportedExampleButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('Dayton v. Stewart'),
		)!;
		const unreportedExampleButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('State v. Lucko'),
		)!;
		const copyButton = buttons.find((b) =>
			b.textContent?.trim().startsWith('Copy'),
		)!;

		let copyResetTimeout: ReturnType<typeof setTimeout> | undefined;
		let lastCitation: { html: string; plain: string } | undefined;

		function resetCopyButtonLabelSoon(): void {
			clearTimeout(copyResetTimeout);
			copyResetTimeout = setTimeout(() => {
				copyButton.textContent = 'Copy';
			}, 2000);
		}

		async function copyCitation(): Promise<void> {
			if (lastCitation === undefined) {
				return;
			}
			const { html, plain } = lastCitation;
			try {
				await navigator.clipboard.write([
					new ClipboardItem({
						'text/html': new Blob([html], { type: 'text/html' }),
						'text/plain': new Blob([plain], { type: 'text/plain' }),
					}),
				]);
				copyButton.textContent = 'Copied!';
			} catch {
				const selection = globalThis.getSelection();
				const range = document.createRange();
				range.selectNodeContents(output);
				selection?.removeAllRanges();
				selection?.addRange(range);
				copyButton.textContent = 'Selected -- press Ctrl/Cmd+C';
			}
			resetCopyButtonLabelSoon();
		}

		const caseTypeSelect = document.querySelector<HTMLSelectElement>(
			`#${ids.caseType}`,
		)!;
		const party1Input = document.querySelector<HTMLInputElement>(
			`#${ids.party1}`,
		)!;
		const party2Input = document.querySelector<HTMLInputElement>(
			`#${ids.party2}`,
		)!;
		const courtInput = document.querySelector<HTMLInputElement>(
			`#${ids.court}`,
		)!;
		const pinciteInput = document.querySelector<HTMLInputElement>(
			`#${ids.pincite}`,
		)!;
		const volumeInput = document.querySelector<HTMLInputElement>(
			`#${ids.volume}`,
		)!;
		const reporterInput = document.querySelector<HTMLInputElement>(
			`#${ids.reporter}`,
		)!;
		const firstPageInput = document.querySelector<HTMLInputElement>(
			`#${ids.firstPage}`,
		)!;
		const yearInput = document.querySelector<HTMLInputElement>(`#${ids.year}`)!;
		const docketNumberInput = document.querySelector<HTMLInputElement>(
			`#${ids.docketNumber}`,
		)!;
		const databaseIdentifierInput = document.querySelector<HTMLInputElement>(
			`#${ids.databaseIdentifier}`,
		)!;
		const monthSelect = document.querySelector<HTMLSelectElement>(
			`#${ids.month}`,
		)!;
		const dayInput = document.querySelector<HTMLInputElement>(`#${ids.day}`)!;
		const dateYearInput = document.querySelector<HTMLInputElement>(
			`#${ids.dateYear}`,
		)!;
		const nameVariantSelect = document.querySelector<HTMLSelectElement>(
			`#${ids.nameVariant}`,
		)!;
		const idCheckbox =
			form.querySelector<HTMLInputElement>('input[name="id"]')!;

		function currentSourceType(): 'reported' | 'unreported' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="sourceType"]:checked',
			);
			return checked?.value === 'unreported' ? 'unreported' : 'reported';
		}

		function currentAvailability(): 'database' | 'slip-opinion' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="availability"]:checked',
			);
			return checked?.value === 'slip-opinion' ? 'slip-opinion' : 'database';
		}

		function currentCaseType(): CaseTypeId {
			const { value } = caseTypeSelect;
			return isCaseTypeId(value) ? value : 'v';
		}

		function currentMode(): 'full' | 'short' {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="mode"]:checked',
			);
			return checked?.value === 'short' ? 'short' : 'full';
		}

		function currentNameVariant(): 'full' | 'party1' | 'party2' | 'none' {
			const { value } = nameVariantSelect;
			return value === 'party1' || value === 'party2' || value === 'none'
				? value
				: 'full';
		}

		function currentEmphasis(): Emphasis {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="emphasis"]:checked',
			);
			return checked?.value === 'underline' ? 'underline' : 'italic';
		}

		function currentSpanSeparator(): SpanSeparator {
			const checked = form.querySelector<HTMLInputElement>(
				'input[name="spanSeparator"]:checked',
			);
			return checked?.value === 'en-dash' ? '–' : '-';
		}

		// Toggles both the native `required` attribute (so the browser's own
		// validation -- triggered on Copy, a submit button -- tells the user
		// exactly which field is missing) and the label's visual "*" marker,
		// which is otherwise invisible to disabled fields' labels too.
		function setRequired(
			input: HTMLInputElement | HTMLSelectElement,
			required: boolean,
		): void {
			input.required = required;
			const marker =
				input.labels?.[0]?.querySelector<HTMLElement>('.required-marker');
			if (marker) {
				marker.hidden = !required;
			}
		}

		// Fields stay visible always (§3.5) -- only their disabled state
		// changes, never their visibility, so switching source type/mode
		// never shifts the layout. Every data field's disabled/required
		// state comes from selectFieldState -- the same, already-unit-tested
		// function that derives required/optional/not-used -- rather than a
		// second, hand-rolled copy of the same rules living only here.
		// r[impl name-variant.short-form-only]
		function setFieldRequirement(
			input: HTMLInputElement | HTMLSelectElement,
			requirement: FieldRequirement,
		): void {
			input.disabled = requirement === 'not-used';
			setRequired(input, requirement === 'required');
		}

		function updateFieldState(): void {
			const mode = currentMode();
			const isShort = mode === 'short';

			const fields = {
				...initialCitationFields(),
				sourceType: currentSourceType(),
				caseType: currentCaseType(),
				availability: currentAvailability(),
			};
			const fieldState = selectFieldState(
				deriveSelections(fields, { ...initialDisplayState(), mode }),
			);

			setFieldRequirement(caseTypeSelect, fieldState.caseType);
			setFieldRequirement(party1Input, fieldState.party1);
			setFieldRequirement(party2Input, fieldState.party2);
			setFieldRequirement(courtInput, fieldState.court);
			setFieldRequirement(pinciteInput, fieldState.pincite);
			setFieldRequirement(volumeInput, fieldState.volume);
			setFieldRequirement(reporterInput, fieldState.reporter);
			setFieldRequirement(firstPageInput, fieldState.firstPage);
			setFieldRequirement(yearInput, fieldState.year);
			setFieldRequirement(monthSelect, fieldState.month);
			setFieldRequirement(dayInput, fieldState.day);
			setFieldRequirement(dateYearInput, fieldState.dateYear);
			setFieldRequirement(docketNumberInput, fieldState.docketNumber);
			setFieldRequirement(
				databaseIdentifierInput,
				fieldState.databaseIdentifier,
			);

			// Name variant / Id.: display controls, not CitationFields data --
			// selectFieldState doesn't (and shouldn't) know about them.
			nameVariantSelect.disabled = !isShort || idCheckbox.checked;
			idCheckbox.disabled = !isShort;

			// Id. (ReportedShortFormInput's/UnreportedShortFormInput's 'id'
			// variant) drops the name entirely, and for reported also drops
			// volume/reporter -- neither is modeled in fieldState since it's
			// a display-state choice, not FieldId data.
			if (isShort && idCheckbox.checked) {
				setRequired(party1Input, false);
				setRequired(volumeInput, false);
				setRequired(reporterInput, false);
			}
		}

		function caseNameInput(): CaseNameInput {
			const caseType = currentCaseType();
			return caseType === 'v'
				? {
						caseType: 'v',
						party1: party1Input.value,
						party2: party2Input.value,
					}
				: { caseType, party1: party1Input.value };
		}

		function reportedShortFormInput(): ReportedShortFormInput {
			if (idCheckbox.checked) {
				return { nameVariant: 'id', pincite: pinciteInput.value };
			}
			const nameVariant = currentNameVariant();
			return nameVariant === 'none'
				? {
						nameVariant: 'none',
						volume: volumeInput.value,
						reporter: reporterInput.value,
						pincite: pinciteInput.value,
					}
				: {
						nameVariant,
						name: caseNameInput(),
						volume: volumeInput.value,
						reporter: reporterInput.value,
						pincite: pinciteInput.value,
					};
		}

		function unreportedShortFormAvailability() {
			return currentAvailability() === 'database'
				? {
						kind: 'database' as const,
						databaseId: databaseIdentifierInput.value,
					}
				: { kind: 'slip-opinion' as const, docket: docketNumberInput.value };
		}

		function unreportedShortFormInput(): UnreportedShortFormInput {
			if (idCheckbox.checked) {
				return {
					nameVariant: 'id',
					availability: unreportedShortFormAvailability(),
					pincite: pinciteInput.value,
				};
			}
			const nameVariant = currentNameVariant();
			return nameVariant === 'none'
				? {
						nameVariant: 'none',
						availability: unreportedShortFormAvailability(),
						pincite: pinciteInput.value,
					}
				: {
						nameVariant,
						name: caseNameInput(),
						availability: unreportedShortFormAvailability(),
						pincite: pinciteInput.value,
					};
		}

		function fillInPlaceholder(): void {
			output.textContent = 'Fill in the fields above to generate a citation.';
			lastCitation = undefined;
		}

		function setCitationOutput(segments: Parameters<typeof render>[0]): void {
			const { html, plain } = render(segments, {
				emphasis: currentEmphasis(),
			});
			output.innerHTML = html;
			lastCitation = { html, plain };
		}

		function updateUnreportedOutput(): void {
			const availability = currentAvailability();

			if (currentMode() === 'short') {
				const hasRequiredFields =
					pinciteInput.value !== '' &&
					(availability === 'database'
						? databaseIdentifierInput.value !== ''
						: docketNumberInput.value !== '') &&
					(idCheckbox.checked ||
						currentNameVariant() === 'none' ||
						party1Input.value !== '');

				if (!hasRequiredFields) {
					fillInPlaceholder();
					return;
				}

				const segments = assembleUnreportedShortForm(
					unreportedShortFormInput(),
					{ spanSeparator: currentSpanSeparator() },
				);
				setCitationOutput(segments);
				return;
			}

			const hasRequiredFields =
				party1Input.value !== '' &&
				courtInput.value !== '' &&
				docketNumberInput.value !== '' &&
				monthSelect.value !== '' &&
				dayInput.value !== '' &&
				dateYearInput.value !== '' &&
				(availability === 'slip-opinion' ||
					databaseIdentifierInput.value !== '');

			if (!hasRequiredFields) {
				fillInPlaceholder();
				return;
			}

			const segments = assembleUnreportedCase(
				{
					name: caseNameInput(),
					docket: docketNumberInput.value,
					availability:
						availability === 'database'
							? { kind: 'database', databaseId: databaseIdentifierInput.value }
							: { kind: 'slip-opinion' },
					pincite: pinciteInput.value === '' ? undefined : pinciteInput.value,
					court: courtInput.value,
					date: {
						month: monthSelect.value as Month,
						day: Number(dayInput.value),
						year: Number(dateYearInput.value),
					},
				},
				{ spanSeparator: currentSpanSeparator() },
			);

			setCitationOutput(segments);
		}

		function updateReportedOutput(): void {
			if (currentMode() === 'short') {
				// Id. (ReportedShortFormInput's 'id' variant) carries neither
				// volume/reporter nor a name -- only pincite -- so those
				// fields drop out of the required-to-generate check here too.
				const hasRequiredFields =
					pinciteInput.value !== '' &&
					(idCheckbox.checked ||
						(volumeInput.value !== '' &&
							reporterInput.value !== '' &&
							(currentNameVariant() === 'none' || party1Input.value !== '')));

				if (!hasRequiredFields) {
					fillInPlaceholder();
					return;
				}

				const segments = assembleReportedShortForm(reportedShortFormInput(), {
					spanSeparator: currentSpanSeparator(),
				});
				setCitationOutput(segments);
				return;
			}

			const hasRequiredFields =
				party1Input.value !== '' &&
				volumeInput.value !== '' &&
				reporterInput.value !== '' &&
				firstPageInput.value !== '';

			if (!hasRequiredFields) {
				fillInPlaceholder();
				return;
			}

			const segments = assembleReportedCase(
				{
					name: caseNameInput(),
					volume: volumeInput.value,
					reporter: reporterInput.value,
					firstPage: firstPageInput.value,
					pincite: pinciteInput.value === '' ? undefined : pinciteInput.value,
					court: courtInput.value === '' ? undefined : courtInput.value,
					year: Number(yearInput.value),
				},
				{ spanSeparator: currentSpanSeparator() },
			);

			setCitationOutput(segments);
		}

		function updateOutput(): void {
			if (currentSourceType() === 'unreported') {
				updateUnreportedOutput();
				return;
			}
			updateReportedOutput();
		}

		function refresh(): void {
			updateFieldState();
			updateOutput();
		}

		function fillReportedExample(): void {
			caseTypeSelect.value = REPORTED_EXAMPLE.caseType;
			party1Input.value = REPORTED_EXAMPLE.party1;
			party2Input.value = REPORTED_EXAMPLE.party2;
			courtInput.value = REPORTED_EXAMPLE.court;
			volumeInput.value = REPORTED_EXAMPLE.volume;
			reporterInput.value = REPORTED_EXAMPLE.reporter;
			firstPageInput.value = REPORTED_EXAMPLE.firstPage;
			pinciteInput.value = REPORTED_EXAMPLE.pincite;
			yearInput.value = REPORTED_EXAMPLE.year;
		}

		function fillUnreportedExample(): void {
			form.querySelector<HTMLInputElement>(
				'input[name="sourceType"][value="unreported"]',
			)!.checked = true;
			caseTypeSelect.value = UNREPORTED_EXAMPLE.caseType;
			party1Input.value = UNREPORTED_EXAMPLE.party1;
			party2Input.value = UNREPORTED_EXAMPLE.party2;
			courtInput.value = UNREPORTED_EXAMPLE.court;
			docketNumberInput.value = UNREPORTED_EXAMPLE.docketNumber;
			databaseIdentifierInput.value = UNREPORTED_EXAMPLE.databaseIdentifier;
			pinciteInput.value = UNREPORTED_EXAMPLE.pincite;
			monthSelect.value = UNREPORTED_EXAMPLE.month;
			dayInput.value = UNREPORTED_EXAMPLE.day;
			dateYearInput.value = UNREPORTED_EXAMPLE.dateYear;
		}

		function resetToDefaults(): void {
			form.reset();
			// Radios/checkboxes reset via their defaultChecked above --
			// blanking their `value` too would corrupt the attribute
			// selectors (like fillUnreportedExample's) rely on to pick a
			// specific option.
			for (const input of form.querySelectorAll<HTMLInputElement>(
				'input:not([type="radio"]):not([type="checkbox"])',
			)) {
				input.value = '';
			}
			caseTypeSelect.value = 'v';
			nameVariantSelect.value = 'full';
			monthSelect.value = '';
		}

		function clearFields(): void {
			resetToDefaults();
			refresh();
		}

		function loadReportedExample(): void {
			resetToDefaults();
			fillReportedExample();
			refresh();
		}

		function loadUnreportedExample(): void {
			resetToDefaults();
			fillUnreportedExample();
			refresh();
		}

		form.addEventListener('input', refresh);
		form.addEventListener('change', refresh);
		clearButton.addEventListener('click', clearFields);
		reportedExampleButton.addEventListener('click', loadReportedExample);
		unreportedExampleButton.addEventListener('click', loadUnreportedExample);
		// Copy is a submit button (form={ids.form}) so clicking it while a
		// required field is empty triggers the browser's own native
		// validation UI -- pointing straight at the missing field -- instead
		// of a hand-rolled banner. Only reaches here once that passes.
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			void copyCitation();
		});

		fillReportedExample();
		refresh();
	</script>
</PageLayout>
