---
import PageLayout from '@layouts/page-layout.astro';
import CitationBuilderUi from './citation-builder.ui.astro';
import { CITATION_BUILDER_NAV_LINKS } from './nav-links';
---

<PageLayout
	title="Bluebook 22 Citation Generator"
	navLinks={CITATION_BUILDER_NAV_LINKS}
>
	<h1 class="my-5 text-3xl font-bold">Bluebook 22 Citation Generator</h1>
	<CitationBuilderUi />
	<script>
		import {
			assemble,
			buildCitationInput,
			findSavedCitation,
			saveCitation,
			updateSavedCitation,
		} from '@components/citation-builder/state';
		import { render } from '@components/citation-builder/domain/render';
		import { createClipboardController } from './clipboard';
		import { queryButtonRefs } from './dom-refs';
		import { EXAMPLES, REPORTED_EXAMPLE } from './examples';
		import { createFormState } from './form-state';
		import {
			loadPersistedState,
			savePersistedState,
		} from '@components/citation-builder/state';
		import type {
			CitationFields,
			DisplayState,
			Emphasis,
		} from '@components/citation-builder/state';

		const form = document.querySelector<HTMLFormElement>('form')!;
		const output = document.querySelector('output')!;
		const { loadExampleButton, exampleSelect, clearButton, copyButton } =
			queryButtonRefs();

		const clipboard = createClipboardController(copyButton, output);
		const formState = createFormState(form);

		let lastRendered: { html: string; plain: string } | undefined;
		let trackedCitationId: string | null = null;
		let suppressAutoSave = false;

		function fillInPlaceholder(): void {
			output.textContent = 'Fill in the fields above to generate a citation.';
			lastRendered = undefined;
			clipboard.setCitation(undefined);
		}

		function setCitationOutput(
			segments: Parameters<typeof render>[0],
			emphasis: Emphasis,
		): void {
			const { html, plain } = render(segments, { emphasis });
			output.innerHTML = html;
			lastRendered = { html, plain };
			clipboard.setCitation({ html, plain });
		}

		function updateOutput(fields: CitationFields, display: DisplayState): void {
			if (!form.checkValidity()) {
				fillInPlaceholder();
				return;
			}
			const segments = assemble(buildCitationInput(fields, display), {
				spanSeparator: display.spanSeparator,
				signal: display.signal,
			});
			setCitationOutput(segments, display.emphasis);
		}

		function autoSaveCitation(
			fields: CitationFields,
			display: DisplayState,
		): void {
			if (lastRendered === undefined || suppressAutoSave) {
				return;
			}
			const label = lastRendered.plain;

			const updated =
				trackedCitationId === null
					? undefined
					: updateSavedCitation(trackedCitationId, fields, display, label);
			const citation = updated ?? saveCitation(fields, display, label);

			if (trackedCitationId !== citation.id) {
				trackedCitationId = citation.id;
				history.replaceState(null, '', `?edit=${citation.id}`);
			}
		}

		function refresh(): void {
			const fields = formState.readFields();
			const display = formState.readDisplay();
			formState.updateFieldState(fields, display);
			updateOutput(fields, display);
			savePersistedState(fields, display);
			autoSaveCitation(fields, display);
		}

		function clearFields(): void {
			formState.resetToDefaults();
			trackedCitationId = null;
			refresh();
		}

		function loadExample(): void {
			const example =
				EXAMPLES.find(
					(candidate) => candidate.sourceType === exampleSelect.value,
				) ?? REPORTED_EXAMPLE;
			formState.resetToDefaults();
			formState.setDisplay({
				...formState.readDisplay(),
				sourceType: example.sourceType,
				...(example.codeType === undefined
					? {}
					: { codeType: example.codeType }),
			});
			formState.setFields(example.fields);
			trackedCitationId = null;
			suppressAutoSave = true;
			refresh();
			suppressAutoSave = false;
		}

		function loadSavedOrExample(): void {
			const saved = loadPersistedState();
			if (saved === null) {
				loadExample();
				return;
			}
			formState.resetToDefaults();
			formState.setFields(saved.fields);
			formState.setDisplay(saved.display);
			refresh();
		}

		function loadForEditing(id: string): boolean {
			const citation = findSavedCitation(id);
			if (citation === undefined) {
				return false;
			}
			formState.resetToDefaults();
			formState.setFields(citation.fields);
			formState.setDisplay(citation.display);
			trackedCitationId = id;
			refresh();
			return true;
		}

		form.addEventListener('input', refresh);
		clearButton.addEventListener('click', clearFields);
		loadExampleButton.addEventListener('click', loadExample);
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			void clipboard.copy();
		});

		const editId = new URLSearchParams(location.search).get('edit');
		if (editId === null || !loadForEditing(editId)) {
			loadSavedOrExample();
		}
	</script>
</PageLayout>
