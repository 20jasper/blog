{
	"name": "blog-jacob-asper",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier ./ --write",
		"format:check": "prettier ./ --check",
		"lint:links": "remark 'src/content/blog/**/*.md' --quiet --frail && remark 'src/content/blog/**/*.mdx' --quiet --frail --use remark-mdx",
		"lint": "astro check && oxlint --type-aware --deny-warnings . && pnpm run lint:links",
		"test:visual:docker": "HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose run --rm visual-tests",
		"test:visual:docker:update": "HOST_UID=$(id -u) HOST_GID=$(id -g) PLAYWRIGHT_ARGS=--update-snapshots docker compose run --rm visual-tests"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.2.4",
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/sitemap": "^3.7.3",
		"@netlify/edge-functions": "^4.0.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.9",
		"effect": "^3.22.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-math": "^6.0.0",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"feed": "^6.0.0",
		"knip": "^6.33.0",
		"lefthook": "^2.1.12",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-validate-links": "^13.1.0"
	},
	"engines": {
		"node": ">=26",
		"pnpm": ">=11"
	}
}
